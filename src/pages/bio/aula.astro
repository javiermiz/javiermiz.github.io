---
import { Image } from "astro:assets";
import Layout from "@components/Layout.astro";
import aulaImg from "@components/bio-items/aula-f75/F75.avif";
---

<Layout
  lang="en"
  title="AULA F75 — Javier Miz"
  description="Teclado Mecánico 75% Inalámbrico"
  hide_header={true}
  hide_footer={true}
  disable_main_padding={true}
>
  <div class="landing">
    <!-- Hero -->
    <section class="hero-section">
      <div class="hero-glow"></div>
      <div class="hero-container">
        <a href="/bio" class="back">← Volver</a>

        <div class="hero-content">
          <span class="badge">Gasket Mount • Tri-Mode</span>
          <h1 class="name">AULA<br />F75</h1>
          <p class="tagline">Teclado Mecánico 75%<br />Sonido premium, precio real</p>
        </div>

        <div class="hero-image">
          <div class="img-glow"></div>
          <Image src={aulaImg} alt="AULA F75" width={600} height={600} class="img" />
        </div>

        <div class="cta-group">
          <a class="cta-primary" href="https://s.click.aliexpress.com/e/_c4mdq9mV" target="_blank" rel="noreferrer">
            <span class="cta-icon">🛒</span>
            <span>Comprar en AliExpress</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Specs -->
    <section class="specs-section">
      <div class="specs-container">
        <h2 class="specs-title">¿Por qué este teclado?</h2>
        <div class="specs-grid">
          <div class="spec-card">
            <div class="spec-icon">🎛️</div>
            <div class="spec-text">
              <strong>Rotary Knob</strong>
              <span>Control de volumen y funciones con un solo giro</span>
            </div>
          </div>
          <div class="spec-card">
            <div class="spec-icon">🔊</div>
            <div class="spec-text">
              <strong>Gasket Mount</strong>
              <span>Sonido profundo y satisfactorio en cada tecla</span>
            </div>
          </div>
          <div class="spec-card">
            <div class="spec-icon">📡</div>
            <div class="spec-text">
              <strong>Tri-Mode</strong>
              <span>Bluetooth, 2.4GHz y USB-C — conéctate como quieras</span>
            </div>
          </div>
          <div class="spec-card">
            <div class="spec-icon">💡</div>
            <div class="spec-text">
              <strong>RGB Per-Key</strong>
              <span>Iluminación personalizable para cada tecla</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="bottom-section">
      <div class="bottom-container">
        <p class="bottom-text">El teclado que cambió mi setup</p>
        <a class="cta-bottom" href="https://s.click.aliexpress.com/e/_c4mdq9mV" target="_blank" rel="noreferrer">
          Comprar ahora →
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(body) {
    background: #080808 !important;
    margin: 0;
    padding: 0;
  }

  .landing {
    width: 100%;
    min-height: 100vh;
    background: #080808;
    color: #fff;
    font-family: var(--font-serif);
  }

  /* ── Hero ── */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1rem 0 2rem;
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 212, 170, 0.12) 0%, transparent 70%);
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.1); }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    padding: 0 1.25rem;
    max-width: 440px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .back {
    align-self: flex-start;
    font-size: 0.75rem;
    color: #555;
    text-decoration: none;
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
  }

  .back:hover { color: #00D4AA; }

  .hero-content {
    margin-bottom: 1.5rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #00D4AA;
    background: rgba(0, 212, 170, 0.08);
    border: 1px solid rgba(0, 212, 170, 0.2);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    margin-bottom: 1rem;
  }

  .name {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #00D4AA 0%, #00FFCC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.8rem;
    color: #777;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Hero Image ── */
  .hero-image {
    position: relative;
    margin-bottom: 2rem;
  }

  .img-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 160px;
    background: radial-gradient(ellipse, rgba(0, 212, 170, 0.18) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(25px);
  }

  .img {
    position: relative;
    width: 260px;
    height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0, 212, 170, 0.12));
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* ── CTA Buttons ── */
  .cta-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cta-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 56px;
    padding: 0 1rem;
    background: linear-gradient(135deg, #00D4AA 0%, #00FFCC 100%);
    color: #080808;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 4px 20px rgba(0, 212, 170, 0.3);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 212, 170, 0.4);
  }

  .cta-primary:active { transform: translateY(0); }

  .cta-icon { font-size: 1.1rem; }

  /* ── Specs ── */
  .specs-section {
    padding: 3rem 0;
    background: #080808;
  }

  .specs-container {
    padding: 0 1.25rem;
    max-width: 440px;
    margin: 0 auto;
  }

  .specs-title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .specs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    backdrop-filter: blur(10px);
  }

  .spec-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 212, 170, 0.08);
    border-radius: 8px;
  }

  .spec-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .spec-text strong {
    font-size: 0.8rem;
    color: #fff;
  }

  .spec-text span {
    font-size: 0.7rem;
    color: #555;
    line-height: 1.4;
  }

  /* ── Bottom CTA ── */
  .bottom-section {
    padding: 2rem 0 3rem;
    background: #080808;
  }

  .bottom-container {
    padding: 0 1.25rem;
    max-width: 440px;
    margin: 0 auto;
    text-align: center;
  }

  .bottom-text {
    font-size: 0.8rem;
    color: #555;
    margin: 0 0 1rem;
  }

  .cta-bottom {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 2rem;
    background: linear-gradient(135deg, #00D4AA 0%, #00FFCC 100%);
    color: #080808;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 212, 170, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cta-bottom:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 212, 170, 0.4);
  }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    .name { font-size: 2.8rem; }
    .tagline { font-size: 0.95rem; }
    .img { width: 340px; height: 260px; }
    .img-glow { width: 300px; height: 220px; }
    .cta-primary { font-size: 1rem; }
  }
</style>
