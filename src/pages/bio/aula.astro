---
import { Image } from "astro:assets";
import Layout from "@components/Layout.astro";
import aulaImg from "@components/bio-items/aula-f75/F75.avif";
---

<Layout
  lang="en"
  title="AULA F75 — Javier Miz"
  description="Teclado Mecánico 75% Inalámbrico"
  hide_header={true}
  hide_footer={true}
  disable_main_padding={true}
>
  <div class="landing">
    <a href="/bio" class="back">← Volver</a>

    <!-- Hero image -->
    <div class="hero">
      <div class="hero-glow"></div>
      <Image src={aulaImg} alt="AULA F75" width={600} height={600} class="img" />
      <div class="fade"></div>
    </div>

    <!-- Info + CTA -->
    <div class="bottom">
      <span class="badge">Gasket Mount · Tri-Mode</span>
      <h1 class="name">AULA F75</h1>
      <p class="tagline">Teclado Mecánico 75% · Sonido Premium</p>

      <div class="cta-group">
        <a class="cta-primary" href="https://s.click.aliexpress.com/e/_c4mdq9mV" target="_blank" rel="noreferrer">
          <span>🛒</span>
          <span>Comprar en AliExpress</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    background: #080808 !important;
    margin: 0;
    padding: 0;
  }

  .landing {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: #080808;
    color: #fff;
    font-family: var(--font-serif);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  .back {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    z-index: 3;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
  }

  .back:hover { color: #00D4AA; }

  /* ── Hero ── */
  .hero {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(0, 212, 170, 0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .img {
    position: relative;
    z-index: 1;
    max-width: 320px;
    max-height: 45vh;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 30px rgba(0, 212, 170, 0.1));
  }

  .fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to top, #080808 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem 2rem;
    margin-top: -2rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #00D4AA;
    background: rgba(0, 212, 170, 0.08);
    border: 1px solid rgba(0, 212, 170, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .name {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.2rem;
    background: linear-gradient(135deg, #00D4AA 0%, #00FFCC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.7rem;
    color: #666;
    margin: 0 0 1rem;
  }

  .cta-group {
    max-width: 360px;
    margin: 0 auto;
  }

  .cta-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 52px;
    background: linear-gradient(135deg, #00D4AA 0%, #00FFCC 100%);
    color: #080808;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 212, 170, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 212, 170, 0.4);
  }

  @media (min-width: 768px) {
    .img { max-width: 420px; max-height: 50vh; }
    .name { font-size: 2rem; }
    .tagline { font-size: 0.85rem; }
    .cta-primary { font-size: 0.95rem; }
  }
</style>
