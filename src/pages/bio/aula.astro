---
import BioLayout from "@components/BioLayout.astro";
import aulaImg from "@components/bio-items/aula-f75/F75.avif";
---

<BioLayout title="AULA F75 — Javier Miz" description="Teclado Mecánico 75% Inalámbrico" bg="#080808">
  <div class="landing">
    <a href="/bio" class="back">← Volver</a>

    <div class="hero" style={`background-image: url(${aulaImg.src})`}>
      <div class="hero-glow"></div>
      <div class="fade-top"></div>
      <div class="fade-bottom"></div>
    </div>

    <div class="bottom">
      <span class="badge">Gasket Mount · Tri-Mode</span>
      <h1 class="name">AULA F75</h1>
      <p class="tagline">Teclado Mecánico 75% · Sonido Premium</p>

      <div class="cta-group">
        <a class="cta-primary" href="https://s.click.aliexpress.com/e/_c4mdq9mV" target="_blank" rel="noreferrer">
          <span>🛒</span>
          <span>Comprar en AliExpress</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </div>
  </div>
</BioLayout>

<style>
  .landing {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .back {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .back:hover { color: #00D4AA; }

  /* ── Hero ── */
  .hero {
    position: relative;
    height: 55vh;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 10% auto auto 50%;
    transform: translateX(-50%);
    width: 75vw;
    max-width: 420px;
    aspect-ratio: 4/3;
    background: radial-gradient(ellipse, rgba(0, 212, 170, 0.16) 0%, transparent 60%);
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }

  .fade-top {
    position: absolute;
    inset: 0 0 auto;
    height: 25%;
    background: linear-gradient(to bottom, rgba(8, 8, 8, 0.8), transparent);
    pointer-events: none;
  }

  .fade-bottom {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, #080808, transparent);
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.25rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    min-height: 0;
  }

  .badge {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #00D4AA;
    background: rgba(0, 212, 170, 0.06);
    border: 1px solid rgba(0, 212, 170, 0.15);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .name {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
    background: linear-gradient(135deg, #00D4AA, #00FFCC 50%, #66FFE0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.65rem;
    color: #555;
    margin-bottom: 1rem;
  }

  .cta-group {
    width: 100%;
    max-width: 340px;
  }

  .cta-primary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 54px;
    background: linear-gradient(135deg, #00D4AA, #00FFCC);
    color: #080808;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 14px;
    box-shadow: 0 4px 24px rgba(0, 212, 170, 0.3), 0 0 0 1px rgba(0, 212, 170, 0.1);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
  }

  .cta-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent 50%);
    pointer-events: none;
  }

  .cta-primary:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 8px 32px rgba(0, 212, 170, 0.4);
  }

  .cta-primary:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-arrow {
    margin-left: 0.25rem;
    transition: transform 0.2s;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* ── Tablet ── */
  @media (min-width: 768px) {
    .back { top: 0.75rem; left: 1rem; font-size: 0.75rem; }
    .bottom { padding: 0 2rem; padding-bottom: max(2rem, env(safe-area-inset-bottom)); }
    .badge { font-size: 0.6rem; padding: 0.3rem 0.8rem; }
    .name { font-size: 2rem; }
    .tagline { font-size: 0.8rem; margin-bottom: 1.25rem; }
    .cta-primary { font-size: 0.95rem; min-height: 56px; border-radius: 16px; }
  }

  @media (min-width: 1024px) {
    .name { font-size: 2.4rem; }
    .tagline { font-size: 0.9rem; }
    .cta-primary { font-size: 1rem; }
  }
</style>
