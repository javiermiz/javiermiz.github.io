---
import { Image } from "astro:assets";
import Layout from "@components/Layout.astro";
import maonoImg from "@components/bio-items/maono-pd200w/PD200W.jpg";

const brand = {
  primary: "#FF6B00",
  bg: "#1A1A1A",
  text: "#FFFFFF",
  muted: "#AAAAAA",
};
---

<Layout
  lang="en"
  title="MAONO PD200W — Javier Miz"
  description="Micrófono Inalámbrico USB-C y XLR"
  hide_header={true}
  hide_footer={true}
  disable_main_padding={true}
>
  <div class="landing">
    <section class="section">
      <div class="container">
        <a href="/bio" class="back">← Volver</a>

        <div class="hero">
          <Image src={maonoImg} alt="MAONO PD200W" width={600} height={600} class="img" />
        </div>

        <div class="info">
          <h1 class="name">MAONO PD200W</h1>
          <p class="tagline">Micrófono Inalámbrico USB-C y XLR</p>
        </div>

        <div class="links">
          <a class="link" href="https://bit.ly/3LrqFXr" target="_blank" rel="noreferrer">
            <img src="/images/mercado-libre.png" alt="Mercado Libre" width={24} height={24} />
            <span>Comprar en Mercado Libre</span>
          </a>
          <a class="link" href="https://amzn.to/4pMeqm8" target="_blank" rel="noreferrer">
            <img src="/images/amazon.png" alt="Amazon" width={24} height={24} />
            <span>Comprar en Amazon</span>
          </a>
          <a class="link" href="https://bit.ly/4pZmEHT" target="_blank" rel="noreferrer">
            <span class="icon">🛒</span>
            <span>Comprar en Maono.mx</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(body) {
    background: #1A1A1A !important;
  }

  .landing {
    width: 100%;
    min-height: 100vh;
    background: #1A1A1A;
    color: #FFFFFF;
  }

  .section {
    padding: 1rem 0;
  }

  .container {
    padding: 0 1rem;
    max-width: 440px;
    margin: 0 auto;
    width: 100%;
  }

  .back {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: #AAA;
    text-decoration: none;
    min-height: 40px;
    line-height: 40px;
    margin-bottom: 0.5rem;
  }

  .back:hover {
    color: #FF6B00;
  }

  .hero {
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .img {
    width: 240px;
    height: 240px;
    object-fit: contain;
  }

  .info {
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: #FF6B00;
    line-height: 1.25;
    margin: 0 0 0.15rem 0;
  }

  .tagline {
    font-family: var(--font-serif);
    font-size: 0.7rem;
    color: #AAA;
    margin: 0;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.6rem 0.75rem;
    border: 1px solid #FF6B00;
    background: transparent;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 600;
    color: #FF6B00;
    transition: background-color 0.15s, color 0.15s;
  }

  .link:hover {
    background: #FF6B00;
    color: #1A1A1A;
  }

  .link:active {
    opacity: 0.85;
  }

  .icon {
    width: 20px;
    text-align: center;
    font-size: 0.85rem;
  }

  @media (min-width: 768px) {
    .img {
      width: 300px;
      height: 300px;
    }

    .name {
      font-size: 1.5rem;
    }

    .tagline {
      font-size: 0.85rem;
    }

    .link {
      font-size: 0.95rem;
    }
  }
</style>
