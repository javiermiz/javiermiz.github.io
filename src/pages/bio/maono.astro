---
import { Image } from "astro:assets";
import Layout from "@components/Layout.astro";
import maonoImg from "@components/bio-items/maono-pd200w/PD200W.jpg";
---

<Layout
  lang="en"
  title="MAONO PD200W — Javier Miz"
  description="Micrófono Inalámbrico USB-C y XLR"
  hide_header={true}
  hide_footer={true}
  disable_main_padding={true}
>
  <div class="landing">
    <a href="/bio" class="back">← Volver</a>

    <div class="hero" style={`background-image: url(${maonoImg.src})`}>
      <div class="hero-glow"></div>
      <div class="fade-top"></div>
      <div class="fade-bottom"></div>
    </div>

    <div class="bottom">
      <span class="badge">USB-C &amp; XLR</span>
      <h1 class="name">MAONO PD200W</h1>
      <p class="tagline">Micrófono Inalámbrico · Calidad de Estudio</p>

      <div class="cta-group">
        <a class="cta-primary" href="https://bit.ly/3LrqFXr" target="_blank" rel="noreferrer">
          <img src="/images/mercado-libre.png" alt="" width={20} height={20} />
          <span>Mercado Libre</span>
        </a>
        <div class="cta-row">
          <a class="cta-secondary" href="https://amzn.to/4pMeqm8" target="_blank" rel="noreferrer">
            <img src="/images/amazon.png" alt="" width={18} height={18} />
            <span>Amazon</span>
          </a>
          <a class="cta-secondary" href="https://bit.ly/4pZmEHT" target="_blank" rel="noreferrer">
            <span>🛒</span>
            <span>Maono.mx</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.documentElement.style.setProperty('--color-site-bg', '#0f0f0f', 'important');
  document.body.style.setProperty('background-color', '#0f0f0f', 'important');
</script>

<style>
  :global(body) {
    background: #0f0f0f !important;
    margin: 0;
    padding: 0;
  }

  .landing {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: #0f0f0f;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .back {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .back:hover { color: #FF6B00; }

  /* ── Hero ── */
  .hero {
    position: relative;
    height: 55vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
    flex-shrink: 0;
  }

  .hero-glow {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 60vw;
    max-width: 350px;
    height: 60vw;
    max-height: 350px;
    background: radial-gradient(circle, rgba(255, 107, 0, 0.18) 0%, transparent 65%);
    pointer-events: none;
  }

  .fade-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 20%;
    background: linear-gradient(to bottom, rgba(15, 15, 15, 0.7) 0%, transparent 100%);
    pointer-events: none;
  }

  .fade-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to top, #0f0f0f 0%, transparent 100%);
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.25rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .badge {
    display: inline-block;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FF6B00;
    background: rgba(255, 107, 0, 0.1);
    border: 1px solid rgba(255, 107, 0, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    margin-bottom: 0.35rem;
  }

  .name {
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.15rem;
    background: linear-gradient(135deg, #FF6B00 0%, #FF8C42 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.65rem;
    color: #777;
    margin: 0 0 0.75rem;
  }

  .cta-group {
    max-width: 360px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cta-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 52px;
    background: linear-gradient(135deg, #FF6B00 0%, #FF8C42 100%);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: inherit;
    text-decoration: none;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(255, 107, 0, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 107, 0, 0.4);
  }

  .cta-primary:active { transform: translateY(0); }

  .cta-row { display: flex; gap: 0.4rem; }

  .cta-secondary {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 48px;
    background: rgba(255, 107, 0, 0.06);
    border: 1px solid rgba(255, 107, 0, 0.2);
    color: #FF6B00;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    border-radius: 10px;
    transition: background 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .cta-secondary:hover { background: rgba(255, 107, 0, 0.12); }
  .cta-secondary:active { opacity: 0.85; }
  .cta-secondary img { border-radius: 3px; }

  /* ── Tablet ── */
  @media (min-width: 768px) {
    .back {
      top: 0.75rem;
      left: 1rem;
      font-size: 0.75rem;
    }

    .bottom {
      padding: 0 2rem;
      padding-bottom: max(2rem, env(safe-area-inset-bottom));
    }

    .badge { font-size: 0.65rem; }

    .name { font-size: 1.8rem; }
    .tagline { font-size: 0.8rem; margin-bottom: 1rem; }

    .cta-primary { font-size: 0.95rem; min-height: 56px; }
    .cta-secondary { font-size: 0.8rem; min-height: 52px; }
  }

  /* ── Desktop ── */
  @media (min-width: 1024px) {
    .name { font-size: 2.2rem; }
    .tagline { font-size: 0.9rem; }
  }
</style>
