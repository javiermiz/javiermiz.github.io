---
import CvTemplate from '../components/templates/cv-template.astro';
import { getLocaleData } from '../utils/i18n';
import Layout from '../components/Layout.astro';

const CV_DATA = await getLocaleData({ language: 'en', page: 'cv' });
---

<Layout
  lang="en"
  title="Javier Miz - Senior Frontend Developer | React.js Expert"
  description="Senior Frontend Developer with 5+ years of experience in React.js, Next.js, TypeScript and modern web technologies. Available for freelance projects and full-time opportunities."
>
  <CvTemplate data={CV_DATA} />
</Layout>

<style>
  /* CV Page Layout */
  .cv-page {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  /* CV Header */
  .cv-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #F5F5F5;
  }
  
  .name {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #000000;
  }
  
  .title {
    font-size: 1.25rem;
    color: #DC2626;
    margin-bottom: 1rem;
    font-weight: 500;
  }
  
  .summary {
    font-size: 1.1rem;
    color: #666666;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  
  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.75rem;
  }
  
  .contact-item {
    font-size: 0.95rem;
    color: #333333;
  }
  
  .contact-item strong {
    color: #000000;
    margin-right: 0.5rem;
  }
  
  .contact-item a {
    color: #DC2626;
    text-decoration: none;
  }
  
  .contact-item a:hover {
    text-decoration: underline;
  }
  
  /* CV Sections */
  .cv-section {
    margin-bottom: 3rem;
  }
  
  .cv-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #000000;
    border-bottom: 1px solid #F5F5F5;
    padding-bottom: 0.5rem;
  }
  
  /* Experience */
  .experience-list,
  .education-list,
  .projects-list,
  .languages-list,
  .certifications-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .experience-item,
  .education-item,
  .project-item,
  .certification-item {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #F5F5F5;
  }
  
  .experience-item:last-child,
  .education-item:last-child,
  .project-item:last-child,
  .certification-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .job-header,
  .edu-header,
  .project-header,
  .cert-header {
    margin-bottom: 1rem;
  }
  
  .job-title,
  .degree,
  .project-title,
  .cert-name {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: #000000;
  }
  
  .job-meta,
  .edu-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.9rem;
    color: #666666;
  }
  
  .company,
  .institution {
    font-weight: 500;
    color: #333333;
  }
  
  .period,
  .project-period,
  .cert-date {
    color: #DC2626;
    font-weight: 500;
  }
  
  .job-summary,
  .edu-description,
  .project-description {
    margin-bottom: 1rem;
    color: #333333;
  }
  
  .achievements {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  
  .achievements li {
    margin-bottom: 0.5rem;
    color: #333333;
  }
  
  .technologies,
  .project-technologies {
    font-size: 0.9rem;
    color: #666666;
    margin-bottom: 0.5rem;
  }
  
  .technologies strong,
  .project-technologies strong {
    color: #333333;
  }
  
  .project-link,
  .cert-link {
    margin-top: 0.5rem;
  }
  
  .project-link a,
  .cert-link a {
    color: #DC2626;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
  }
  
  .project-link a:hover,
  .cert-link a:hover {
    text-decoration: underline;
  }
  
  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .skill-category-title {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #000000;
  }
  
  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .skill-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #F5F5F5;
  }
  
  .skill-item:last-child {
    border-bottom: none;
  }
  
  .skill-name {
    color: #333333;
  }
  
  .skill-level {
    color: #666666;
    font-size: 0.9rem;
  }
  
  /* Languages */
  .languages-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  
  .language-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background-color: #F5F5F5;
    border-radius: 6px;
  }
  
  .language-name {
    color: #333333;
    font-weight: 500;
  }
  
  .language-level {
    color: #666666;
    font-size: 0.9rem;
  }
  
  /* Responsive Design */
  @media (max-width: 768px) {
    .name {
      font-size: 2rem;
    }
    
    .contact-info {
      grid-template-columns: 1fr;
    }
    
    .job-meta,
    .edu-meta {
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .languages-list {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 480px) {
    .name {
      font-size: 1.75rem;
    }
    
    .title {
      font-size: 1.1rem;
    }
    
    .summary {
      font-size: 1rem;
    }
    
    .cv-section h2 {
      font-size: 1.3rem;
    }
    
    .job-title,
    .degree,
    .project-title,
    .cert-name {
      font-size: 1.1rem;
    }
  }
  
  /* Print Styles */
  @media print {
    .cv-page {
      max-width: none;
      margin: 0;
    }
    
    .cv-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
    }
    
    .cv-section {
      margin-bottom: 2rem;
    }
    
    .contact-item a {
      color: #000000;
      text-decoration: none;
    }
    
    .project-link a,
    .cert-link a {
      color: #000000;
    }
  }
</style>
