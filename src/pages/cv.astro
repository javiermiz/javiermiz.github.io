---
import CvTemplate from "@components/templates/cv-template.astro";
import { getLocaleData } from "../utils/i18n";
import Layout from "@components/Layout.astro";

const CV_DATA = await getLocaleData({ page: "cv" });
---

<Layout
  lang="es"
  title="Javier Miz - Desarrollador Frontend Senior | Experto en React.js"
  description="Desarrollador Frontend Senior con más de 5 años de experiencia en React.js, Next.js, TypeScript y tecnologías web modernas. Disponible para proyectos freelance y oportunidades a tiempo completo."
>
  <CvTemplate data={CV_DATA} />
</Layout>
