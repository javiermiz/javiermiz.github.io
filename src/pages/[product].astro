---
import BioLayout from "@components/BioLayout.astro";
import products from "@data/products.json";
import type { ImageMetadata } from "astro";

interface ProductLink {
  store: string;
  label: string;
  url: string;
  icon: string | null;
}

interface Product {
  code: string;
  slug: string;
  name: string;
  badge: string;
  tagline: string;
  description: string;
  bg: string;
  accent: string;
  ctaText: string;
  links: ProductLink[];
}

export function getStaticPaths() {
  return (products as Product[]).map((product) => ({
    params: { product: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

// Resolve the hero image for this product from src/assets/products/<slug>.<ext>
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/*.{avif,jpg,jpeg,png,webp}",
  { eager: true },
);
const heroEntry = Object.entries(heroImages).find(([path]) =>
  path.includes(`/${product.slug}.`),
);
const heroSrc = heroEntry?.[1].default.src ?? "";

const [primaryLink, ...secondaryLinks] = product.links;

const trackId = (store: string) =>
  `bio-${product.slug}-${store.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<BioLayout
  title={`${product.name} — Javier Miz`}
  description={product.description}
  bg={product.bg}
>
  <div
    class="landing"
    style={`--accent:${product.accent};--bg:${product.bg};--cta-text:${product.ctaText}`}
  >
    <a href="/" class="back">← Volver</a>

    <div class="hero" style={`background-image: url(${heroSrc})`}>
      <div class="hero-glow"></div>
      <div class="fade-top"></div>
      <div class="fade-bottom"></div>
    </div>

    <div class="bottom">
      <span class="badge">{product.badge}</span>
      <h1 class="name">{product.name}</h1>
      <p class="tagline">{product.tagline}</p>

      <div class="cta-group">
        <a
          class="cta-primary"
          href={primaryLink.url}
          target="_blank"
          rel="noopener noreferrer sponsored"
          data-goatcounter-click={trackId(primaryLink.store)}
          data-goatcounter-title={`${product.name} - ${primaryLink.store}`}
        >
          {
            primaryLink.icon ? (
              <img src={primaryLink.icon} alt="" width={20} height={20} />
            ) : (
              <span>🛒</span>
            )
          }
          <span>{primaryLink.label}</span>
          <span class="cta-arrow">→</span>
        </a>

        {
          secondaryLinks.length > 0 && (
            <div class="cta-row">
              {secondaryLinks.map((link) => (
                <a
                  class="cta-secondary"
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-goatcounter-click={trackId(link.store)}
                  data-goatcounter-title={`${product.name} - ${link.store}`}
                >
                  {link.icon ? (
                    <img src={link.icon} alt="" width={18} height={18} />
                  ) : (
                    <span>🛒</span>
                  )}
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</BioLayout>

<style>
  .landing {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .back {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .back:hover {
    color: var(--accent);
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    height: 55vh;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 10% auto auto 50%;
    transform: translateX(-50%);
    width: 75vw;
    max-width: 420px;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 18%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .fade-top {
    position: absolute;
    inset: 0 0 auto;
    height: 25%;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 80%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .fade-bottom {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, var(--bg), transparent);
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.25rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    min-height: 0;
  }

  .badge {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .name {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
    background: linear-gradient(
      135deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 60%, white) 50%,
      color-mix(in srgb, var(--accent) 35%, white)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.65rem;
    color: #777;
    margin-bottom: 1rem;
  }

  .cta-group {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cta-primary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 54px;
    background: linear-gradient(
      135deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 75%, white)
    );
    color: var(--cta-text);
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 14px;
    box-shadow:
      0 4px 24px color-mix(in srgb, var(--accent) 35%, transparent),
      0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
  }

  .cta-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18),
      transparent 50%
    );
    pointer-events: none;
  }

  .cta-primary:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .cta-primary:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-primary img {
    border-radius: 3px;
  }

  .cta-arrow {
    margin-left: 0.25rem;
    transition: transform 0.2s;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(3px);
  }

  .cta-row {
    display: flex;
    gap: 0.4rem;
  }

  .cta-secondary {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 48px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #999;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .cta-secondary:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-color: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent);
  }

  .cta-secondary:active {
    opacity: 0.85;
  }

  .cta-secondary img {
    border-radius: 3px;
  }

  /* ── Tablet ── */
  @media (min-width: 768px) {
    .back {
      top: 0.75rem;
      left: 1rem;
      font-size: 0.75rem;
    }
    .bottom {
      padding: 0 2rem;
      padding-bottom: max(2rem, env(safe-area-inset-bottom));
    }
    .badge {
      font-size: 0.6rem;
      padding: 0.3rem 0.8rem;
    }
    .name {
      font-size: 2rem;
    }
    .tagline {
      font-size: 0.8rem;
      margin-bottom: 1.25rem;
    }
    .cta-primary {
      font-size: 0.95rem;
      min-height: 56px;
      border-radius: 16px;
    }
    .cta-secondary {
      font-size: 0.8rem;
      min-height: 52px;
    }
  }

  @media (min-width: 1024px) {
    .name {
      font-size: 2.4rem;
    }
    .tagline {
      font-size: 0.9rem;
    }
    .cta-primary {
      font-size: 1rem;
    }
  }
</style>
