---
import BioLayout from "@components/BioLayout.astro";
import products from "@data/products.json";
import type { ImageMetadata } from "astro";

interface ProductLink {
  store: string;
  url: string;
  icon: string | null;
}

interface Product {
  code: string;
  slug: string;
  name: string;
  badge: string;
  tagline: string;
  description: string;
  bg: string;
  accent: string;
  ctaText: string;
  features?: string[];
  links: ProductLink[];
}

export function getStaticPaths() {
  return (products as Product[]).map((product) => ({
    params: { product: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

// Resolve the hero image for this product from src/assets/products/<slug>.<ext>
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/*.{avif,jpg,jpeg,png,webp}",
  { eager: true },
);
const heroEntry = Object.entries(heroImages).find(([path]) =>
  path.includes(`/${product.slug}.`),
);
const heroSrc = heroEntry?.[1].default.src ?? "";

const trackId = (store: string) =>
  `bio-${product.slug}-${store.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<BioLayout
  title={`${product.name} — Javier Miz`}
  description={product.description}
  bg={product.bg}
  ogImage={heroSrc}
>
  <div
    class="landing"
    style={`--accent:${product.accent};--bg:${product.bg};--cta-text:${product.ctaText}`}
  >
    <a href="/" class="back">← Volver</a>

    <div class="hero" style={`background-image: url(${heroSrc})`}>
      <div class="hero-glow"></div>
      <div class="fade-top"></div>
      <div class="fade-bottom"></div>
    </div>

    <div class="bottom">
      <span class="badge">{product.badge}</span>
      <h1 class="name">{product.name}</h1>
      <p class="tagline">{product.tagline}</p>

      {
        product.features && product.features.length > 0 && (
          <ul class="specs">
            {product.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        )
      }

      <div class="buy-group">
        {
          product.links.map((link) => (
            <a
              class="buy-btn"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer sponsored"
              data-goatcounter-click={trackId(link.store)}
              data-goatcounter-title={`${product.name} - ${link.store}`}
            >
              {link.icon ? (
                <img src={link.icon} alt="" width={22} height={22} />
              ) : (
                <span class="buy-glyph">🛒</span>
              )}
              <span>Comprar en {link.store}</span>
              <span class="buy-arrow">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BioLayout>

<style>
  /* Scroll-safe: grows past the viewport when content is tall instead of clipping */
  .landing {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .back {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .back:hover {
    color: var(--accent);
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    height: 42vh;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 10% auto auto 50%;
    transform: translateX(-50%);
    width: 75vw;
    max-width: 420px;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 18%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .fade-top {
    position: absolute;
    inset: 0 0 auto;
    height: 25%;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 80%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .fade-bottom {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, var(--bg), transparent);
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem 1.25rem max(1.5rem, env(safe-area-inset-bottom));
    min-height: 0;
  }

  .badge {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .name {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
    background: linear-gradient(
      135deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 60%, white) 50%,
      color-mix(in srgb, var(--accent) 35%, white)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.65rem;
    color: #777;
    margin-bottom: 1rem;
  }

  /* ── Specs (per-product personalization) ── */
  .specs {
    list-style: none;
    width: 100%;
    max-width: 340px;
    margin: 0 auto 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .specs li {
    position: relative;
    text-align: left;
    padding-left: 1.1rem;
    font-size: 0.72rem;
    line-height: 1.35;
    color: #b0b0b0;
  }

  .specs li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  /* ── Buy buttons: every store has equal weight ── */
  .buy-group {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .buy-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 56px;
    padding: 0 1rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 14px;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .buy-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--cta-text);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .buy-btn:active {
    transform: translateY(0) scale(0.99);
  }

  .buy-btn img {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    flex-shrink: 0;
  }

  .buy-glyph {
    font-size: 1.05rem;
  }

  .buy-arrow {
    transition: transform 0.2s;
  }

  .buy-btn:hover .buy-arrow {
    transform: translateX(3px);
  }

  /* ── Tablet ── */
  @media (min-width: 768px) {
    .back {
      top: 0.75rem;
      left: 1rem;
      font-size: 0.75rem;
    }
    .hero {
      height: 46vh;
    }
    .bottom {
      padding: 1.25rem 2rem max(2rem, env(safe-area-inset-bottom));
    }
    .badge {
      font-size: 0.6rem;
      padding: 0.3rem 0.8rem;
    }
    .name {
      font-size: 2rem;
    }
    .tagline {
      font-size: 0.8rem;
      margin-bottom: 1.25rem;
    }
    .specs li {
      font-size: 0.78rem;
    }
    .buy-btn {
      font-size: 0.95rem;
      min-height: 58px;
      border-radius: 16px;
    }
  }

  @media (min-width: 1024px) {
    .name {
      font-size: 2.4rem;
    }
    .tagline {
      font-size: 0.9rem;
    }
  }
</style>
