---
import Layout from "@components/Layout.astro";
import Image from "astro/components/Image.astro";
import {
  Mail,
  MapPin,
  Clock,
  ArrowRight,
  Briefcase,
  Languages,
  BookOpen,
  GraduationCap,
  FolderGit2,
} from "lucide-react";

export const CV_DATA = {
  profile: {
    name: "Javier Miz Arévalo",
    role: "Frontend Developer",
    location: "Remote preferred",
    availability: "Ready in 2 weeks",
    headline: "Worked as Senior and Mid Frontend Engineer",
    subheadline:
      "5+ years crafting high-performance web applications with measurable business impact",
    about:
      "Expertise in React ecosystem and e-commerce solutions. Experienced in architecting scalable applications and developing custom Shopify experiences for international clients. Strong background in optimizing web performance and creating maintainable component systems. Proven ability to deliver high-impact solutions in both startup and enterprise environments, consistently combining technical excellence with business value.",
  },
  highlights: [
    "Led development of delivery system reducing late deliveries by 3.4% for Fortune 500 retailer",
    "Architected custom Shopify solutions for international brands increasing conversion rates",
  ],
  expertise: {
    technical_skills: [
      {
        name: "React/Next.js",
        level: "5+ years",
        proficiency: "Expert",
      },
      {
        name: "TypeScript",
        level: "3+ years",
        proficiency: "Advanced",
      },
      {
        name: "Shopify/Liquid",
        level: "2+ years",
        proficiency: "Advanced",
      },
      {
        name: "Node.js",
        level: "3+ years",
        proficiency: "Intermediate",
      },
      {
        name: "Testing (Jest/RTL)",
        level: "1+ years",
        proficiency: "Medium",
      },
      {
        name: "REST APIs",
        level: "4+ years",
        proficiency: "Advanced",
      },
    ],
    soft_skills: [
      "Problem Solving",
      "Technical Leadership",
      "Communication",
      "Mentoring",
      "Agile/Scrum",
      "Client Relations",
    ],
    tools_platforms: [
      "Git/GitHub",
      "AWS",
      "Firebase",
      "Vercel",
      "Figma",
      "WordPress",
    ],
  },
  projects: [
    {
      name: "McDonald's McRib Sauce Campaign",
      involvement:
        "Frontend Developer - Led development for high-profile nationwide e-commerce campaign that sold out limited edition McRib sauce, featured in major publications including PEOPLE Magazine",
      url: "https://people.com/a-whole-lotta-mcrib-sauce-mcdonald-s-releases-half-gallon-jugs-8748982",
      buttonText: "Read Press Coverage",
      note: "Campaign website was time-limited by design as part of the marketing strategy for this exclusive product launch",
    },
    {
      name: "Home Depot Delivery System",
      involvement:
        "Frontend Developer - Developed critical features for large-scale delivery estimation system, impacting millions of daily deliveries for Fortune 500 retailer",
    },
    {
      name: "Adrienne Landau - Fashion Store",
      url: "https://adriennelandau.com",
      involvement:
        "Lead Frontend Developer - Transformed design into high-performance Shopify store, driving significant sales growth through custom features and optimizations",
    },
    {
      name: "Pretty Smart Cosmetics",
      url: "https://pretty-smartcosmetics.com",
      involvement:
        "Lead Frontend Developer - Built custom Shopify storefront from design to deployment, implementing bespoke features and optimized shopping experience",
    },
    {
      name: "Sandblast Solutions E-commerce Platform",
      url: "https://sandblastinc.com",
      involvement:
        "Lead Frontend Developer - Executed complete platform redesign and modernization using Shopify and Tailwind, delivering a high-performance B2B e-commerce solution with custom features and improved user experience",
    },
  ],
  experience: [
    {
      company: "IBM (Project Home Depot)",
      role: "Frontend Developer",
      project: "Home Depot",
      period: "2023 - 2024",
      location: "Remote",
      impact_summary:
        "Driving critical improvements in delivery system performance and frontend modernization",
      tech_stack: ["React", "TypeScript", "Jest", "CI/CD"], // Adding common IBM tech stack
      key_contributions: [
        "Spearheaded delivery logic optimization initiatives achieving 3.4% reduction in late deliveries and 1.5% improvement in accuracy",
        "Modernized frontend applications through tech stack updates, resulting in measurable performance improvements and enhanced user experience",
        "Implemented robust holiday delivery adjustment system to improve estimate accuracy during peak seasons",
        "Led security enhancement efforts by identifying and updating vulnerable dependencies across the application",
        "Established and implemented frontend interface standards, increasing consistency across the platform",
        "Enhanced testing infrastructure by resolving integration issues, ensuring accurate coverage reporting and code quality",
      ],
    },
    {
      company: "Klever Cookie",
      role: "Frontend Developer",
      period: "2021 - Present",
      location: "Remote",
      current: true,
      impact_summary:
        "Specialized in Shopify development and React-based solutions for e-commerce",
      tech_stack: [
        "Shopify/Liquid",
        "Next.js",
        "React",
        "TypeScript",
        "Vue.js",
        "WordPress",
      ],
      key_contributions: [
        "Mastered Shopify theme development, creating custom sections and features using Liquid templating and JavaScript",
        "Implemented complex animations and interactive elements across multiple Shopify stores to enhance product showcases",
        "Led the company website development with Next.js, focusing on performance optimization and responsive design",
        "Built reusable React components for both company website and client projects",
        "Expanded skill set by learning Vue.js to develop business applications",
        "Created custom WordPress solutions while maintaining focus on Shopify and React development",
      ],
    },
    {
      company: "Freelance",
      role: "Frontend Developer",
      period: "2020 - 2022",
      impact_summary:
        "Delivered custom web solutions for small businesses focusing on user experience",
      tech_stack: [
        "React",
        "Angular",
        "Ionic",
        "Firebase",
        "Google Maps API",
        "WordPress",
      ],
      key_contributions: [
        "Built a React-based restaurant reservation system handling daily bookings",
        "Developed a delivery tracking application using Angular/Ionic and Firebase",
        "Implemented location-based features using Google Maps API",
        "Created custom WordPress solutions including appointment booking systems",
        "Focused on mobile-first design principles improving overall user experience",
      ],
    },
    {
      company: "Nett",
      role: "Frontend Developer",
      period: "2018 - 2021",
      location: "Monterrey, NL",
      impact_summary:
        "Developed responsive web applications and mobile solutions using modern frontend technologies",
      tech_stack: [
        "React",
        "TypeScript",
        "Ionic",
        "SASS",
        "Bootstrap",
        "WordPress",
        "Node.js",
        "Git",
      ],
      key_contributions: [
        "Developed mobile applications using React and Ionic frameworks",
        "Created reusable React components to improve development efficiency",
        "Implemented responsive designs ensuring optimal display across devices",
        "Used modern development tools including Webpack and Git for version control",
        "Built and maintained WordPress sites with custom themes and functionality",
      ],
    },
  ],
  education: {
    degree: "Computer Systems Engineering",
    institution: "Universidad de Montemorelos",
    year: "2018",
    relevance:
      "Strong foundation in software engineering principles and system architecture",
  },
};
---

<Layout lang="en" title="Javier Miz - Frontend Developer">
  <main class="max-w-4xl mx-auto p-4 lg:px-6 lg:py-16">
    {/* Profile Header */}
    <section
      class="bg-white dark:bg-zinc-900 border-2 border-black dark:border-zinc-600 rounded-xl p-6 lg:p-10 space-y-8"
    >
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">
        {/* Avatar */}
        <div
          class="w-28 h-28 lg:w-32 lg:h-32 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-400 dark:text-zinc-500 overflow-hidden"
        >
          <Image
            class="w-full h-full object-cover"
            src="/profile-og.jpg"
            alt="Javier Miz"
            width="128"
            height="128"
          />
        </div>

        {/* Info */}
        <div class="flex-1 space-y-4">
          <div class="flex items-center gap-4 text-sm">
            <span
              class="flex items-center gap-1.5 text-green-600 dark:text-green-400 font-bold"
            >
              <Clock className="w-4 h-4" />
              {CV_DATA.profile.availability}
            </span>
          </div>

          <div>
            <h1
              class="text-3xl lg:text-4xl font-bold text-zinc-900 dark:text-white font-primary"
            >
              {CV_DATA.profile.name}
            </h1>
            <p
              class="text-xl lg:text-2xl text-zinc-800 dark:text-zinc-200 mt-1"
            >
              {CV_DATA.profile.role}
            </p>
          </div>

          <div class="flex gap-3 text-base text-zinc-600 dark:text-zinc-400">
            <span
              class="font-bold text-amber-600 dark:text-amber-400 flex items-center gap-2"
            >
              <MapPin className="w-5 h-5" />
              {CV_DATA.profile.location}
            </span>
          </div>
        </div>
      </div>

      <div class="pt-8 border-t dark:border-zinc-800">
        {/* Navigation Buttons */}
        <div class="flex flex-wrap gap-3">
          <a
            href="#expertise"
            class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-full text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <Briefcase className="w-4 h-4" />
            Expertise
          </a>
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-full text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <FolderGit2 className="w-4 h-4" />
            Projects
          </a>
          <a
            href="#experience"
            class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-full text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <BookOpen className="w-4 h-4" />
            Work Experience
          </a>
          <a
            href="#education"
            class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-full text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <GraduationCap className="w-4 h-4" />
            Education
          </a>
        </div>
      </div>

      <div class="pt-8 border-t dark:border-zinc-800 space-y-6">
        {/* Headline */}
        <div class="space-y-2">
          <h2
            class="text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white"
          >
            {CV_DATA.profile.headline}
          </h2>
          <p class="text-lg lg:text-xl text-zinc-800 dark:text-zinc-200">
            {CV_DATA.profile.subheadline}
          </p>
        </div>

        {/* Key Achievements */}
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-zinc-800 dark:text-zinc-200">
            Key Achievements
          </h3>
          <ul class="space-y-3">
            {
              CV_DATA.highlights.map((highlight) => (
                <li class="flex gap-3 text-zinc-700 dark:text-zinc-300">
                  <ArrowRight className="w-5 h-5 mt-1 shrink-0" />
                  <span class="text-base leading-relaxed">{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {/* About */}
        <p class="text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
          {CV_DATA.profile.about}
        </p>
      </div>

      {/* Expertise */}
      <div id="expertise" class="pt-8 border-t dark:border-zinc-800 space-y-6">
        <h2
          class="flex gap-2 items-center text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white"
        >
          <Briefcase className="w-6 h-6" />
          Skills & Expertise
        </h2>

        <div class="space-y-8">
          {/* Technical Skills */}
          <div>
            <h3
              class="text-base font-semibold text-zinc-700 dark:text-zinc-300 mb-4"
            >
              Technical Skills
            </h3>
            <div class="flex flex-wrap gap-3">
              {
                CV_DATA.expertise.technical_skills.map((skill) => (
                  <span class="px-4 py-2 bg-black dark:bg-white text-white dark:text-black text-base rounded-full flex items-center gap-2">
                    {skill.name}
                    <span class="text-sm px-2 py-0.5 bg-white/20 dark:bg-black/20 rounded-full">
                      {skill.level}
                    </span>
                  </span>
                ))
              }
            </div>
          </div>

          {/* Soft Skills */}
          <div>
            <h3
              class="text-base font-semibold text-zinc-700 dark:text-zinc-300 mb-4"
            >
              Professional Skills
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                CV_DATA.expertise.soft_skills.map((skill) => (
                  <span class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-base rounded-full">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>

          {/* Tools & Platforms */}
          <div>
            <h3
              class="text-base font-semibold text-zinc-700 dark:text-zinc-300 mb-4"
            >
              Tools & Platforms
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                CV_DATA.expertise.tools_platforms.map((tool) => (
                  <span class="px-4 py-2 border-2 border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-base rounded-full">
                    {tool}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Projects */}
    <section
      id="projects"
      class="mt-8 bg-white dark:bg-zinc-900 border-2 border-black dark:border-zinc-700 rounded-xl p-6 lg:p-10 space-y-8"
    >
      <h2 class="text-2xl lg:text-3xl font-bold text-zinc-900 dark:text-white">
        Recent Projects
      </h2>
      <div class="divide-y dark:divide-zinc-800 space-y-6">
        {
          CV_DATA.projects.map((project) => (
            <div class="pt-6 first:pt-0">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="space-y-2">
                  <h3 class="text-xl font-bold text-zinc-900 dark:text-white">
                    {project.name}
                  </h3>
                  <p class="text-base text-zinc-600 dark:text-zinc-400">
                    {project.involvement}
                  </p>
                  {project.note && (
                    <p class="text-sm text-zinc-500 dark:text-zinc-500 italic mt-2">
                      {project.note}
                    </p>
                  )}
                </div>
                {project.url && (
                  <a
                    href={project.url}
                    class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-full text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.buttonText || "View Project"}
                    <ArrowRight className="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* Experience */}
    <section
      id="experience"
      class="mt-8 bg-white dark:bg-zinc-900 border-2 border-black dark:border-zinc-700 rounded-xl p-6 lg:p-10 space-y-8"
    >
      <h2 class="text-2xl lg:text-3xl font-bold text-zinc-900 dark:text-white">
        Work Experience
      </h2>
      <div class="divide-y dark:divide-zinc-800 space-y-2">
        {
          CV_DATA.experience.map((job) => (
            <div class="py-8 first:pt-0 last:pb-0 space-y-6">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white">
                    {job.company}
                  </h3>
                  <p class="text-lg text-zinc-800 dark:text-zinc-200 mt-1">
                    {job.role}
                  </p>
                  {job.location && (
                    <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
                      {job.location}
                    </p>
                  )}
                </div>
                <div class="text-right shrink-0">
                  <span class="text-base text-zinc-600 dark:text-zinc-400">
                    {job.period}
                  </span>
                  {job.current && (
                    <div class="mt-2">
                      <span class="px-3 py-1.5 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-sm font-medium rounded-full">
                        Current
                      </span>
                    </div>
                  )}
                </div>
              </div>

              {/* Impact Summary */}
              <div class="bg-zinc-50 dark:bg-zinc-800 p-6 rounded-lg">
                <p class="text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                  {job.impact_summary}
                </p>
              </div>

              {/* Tech Stack */}
              <div class="flex flex-wrap gap-2">
                {job.tech_stack.map((tech) => (
                  <span class="px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-sm font-medium rounded-full">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Key Contributions */}
              <ul class="space-y-4">
                {job.key_contributions.map((contribution) => (
                  <li class="flex items-start gap-3 text-zinc-700 dark:text-zinc-300">
                    <ArrowRight className="w-5 h-5 mt-1 shrink-0" />
                    <span class="text-base leading-relaxed">
                      {contribution}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {/* Education */}
    <section
      id="education"
      class="mt-8 bg-white dark:bg-zinc-900 border-2 border-black dark:border-zinc-700 rounded-xl p-6 lg:p-10"
    >
      <h2
        class="text-2xl lg:text-3xl font-bold text-zinc-900 dark:text-white mb-6"
      >
        Education
      </h2>
      <div class="space-y-3">
        <h3 class="text-xl font-bold text-zinc-800 dark:text-zinc-200">
          {CV_DATA.education.degree}
        </h3>
        <p class="text-lg text-zinc-700 dark:text-zinc-300">
          {CV_DATA.education.institution}
        </p>
        <p class="text-base text-zinc-600 dark:text-zinc-400">
          {CV_DATA.education.year}
        </p>
        <p
          class="text-base text-zinc-700 dark:text-zinc-300 leading-relaxed mt-6"
        >
          {CV_DATA.education.relevance}
        </p>
      </div>
    </section>
  </main>
</Layout>
<style>
  #expertise,
  #experience,
  #projects,
  #education {
    scroll-margin-top: 4rem;
  }
</style>
