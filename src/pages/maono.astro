---
import BioLayout from "@components/BioLayout.astro";
import maonoImg from "@components/bio-items/maono-pd200w/PD200W.jpg";
---

<BioLayout title="MAONO PD200W — Javier Miz" description="Micrófono Inalámbrico USB-C y XLR" bg="#0a0a0a">
  <div class="landing">
    <a href="/" class="back">← Volver</a>

    <div class="hero" style={`background-image: url(${maonoImg.src})`}>
      <div class="hero-glow"></div>
      <div class="fade-top"></div>
      <div class="fade-bottom"></div>
    </div>

    <div class="bottom">
      <span class="badge">USB-C &amp; XLR</span>
      <h1 class="name">MAONO PD200W</h1>
      <p class="tagline">Micrófono Inalámbrico · Calidad de Estudio</p>

      <div class="cta-group">
        <a class="cta-primary" href="https://bit.ly/3LrqFXr" target="_blank" rel="noreferrer">
          <img src="/images/mercado-libre.png" alt="" width={20} height={20} />
          <span>Mercado Libre</span>
          <span class="cta-arrow">→</span>
        </a>
        <div class="cta-row">
          <a class="cta-secondary" href="https://amzn.to/4pMeqm8" target="_blank" rel="noreferrer">
            <img src="/images/amazon.png" alt="" width={18} height={18} />
            <span>Amazon</span>
          </a>
          <a class="cta-secondary" href="https://bit.ly/4pZmEHT" target="_blank" rel="noreferrer">
            <span>🛒</span>
            <span>Maono.mx</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BioLayout>

<style>
  .landing {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .back {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    min-height: 44px;
    line-height: 44px;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .back:hover { color: #FF6B00; }

  /* ── Hero ── */
  .hero {
    position: relative;
    height: 55vh;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 10% auto auto 50%;
    transform: translateX(-50%);
    width: 70vw;
    max-width: 380px;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 107, 0, 0.2) 0%, transparent 60%);
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }

  .fade-top {
    position: absolute;
    inset: 0 0 auto;
    height: 25%;
    background: linear-gradient(to bottom, rgba(10, 10, 10, 0.8), transparent);
    pointer-events: none;
  }

  .fade-bottom {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, #0a0a0a, transparent);
    pointer-events: none;
  }

  /* ── Bottom ── */
  .bottom {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.25rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    min-height: 0;
  }

  .badge {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FF6B00;
    background: rgba(255, 107, 0, 0.08);
    border: 1px solid rgba(255, 107, 0, 0.2);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .name {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
    background: linear-gradient(135deg, #FF6B00, #FF8C42 50%, #FFB366);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 0.65rem;
    color: #666;
    margin-bottom: 1rem;
  }

  .cta-group {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cta-primary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 54px;
    background: linear-gradient(135deg, #FF6B00, #FF8C42);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 14px;
    box-shadow: 0 4px 24px rgba(255, 107, 0, 0.35), 0 0 0 1px rgba(255, 107, 0, 0.1);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
  }

  .cta-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent 50%);
    pointer-events: none;
  }

  .cta-primary:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 8px 32px rgba(255, 107, 0, 0.45);
  }

  .cta-primary:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-arrow {
    margin-left: 0.25rem;
    transition: transform 0.2s;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(3px);
  }

  .cta-row {
    display: flex;
    gap: 0.4rem;
  }

  .cta-secondary {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 48px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #999;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .cta-secondary:hover {
    background: rgba(255, 107, 0, 0.06);
    border-color: rgba(255, 107, 0, 0.2);
    color: #FF6B00;
  }

  .cta-secondary:active { opacity: 0.85; }
  .cta-secondary img { border-radius: 3px; }

  /* ── Tablet ── */
  @media (min-width: 768px) {
    .back { top: 0.75rem; left: 1rem; font-size: 0.75rem; }
    .bottom { padding: 0 2rem; padding-bottom: max(2rem, env(safe-area-inset-bottom)); }
    .badge { font-size: 0.6rem; padding: 0.3rem 0.8rem; }
    .name { font-size: 2rem; }
    .tagline { font-size: 0.8rem; margin-bottom: 1.25rem; }
    .cta-primary { font-size: 0.95rem; min-height: 56px; border-radius: 16px; }
    .cta-secondary { font-size: 0.8rem; min-height: 52px; }
  }

  @media (min-width: 1024px) {
    .name { font-size: 2.4rem; }
    .tagline { font-size: 0.9rem; }
    .cta-primary { font-size: 1rem; }
  }
</style>
