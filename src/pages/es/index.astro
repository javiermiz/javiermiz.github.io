        "React",
        "TypeScript",
        "Ionic",
        "SASS",
        "Bootstrap",
        "WordPress",
        "Node.js",
        "Git",
      ],
      key_contributions: [
        "Desarrollé aplicaciones móviles usando frameworks React e Ionic",
        "Creé componentes React reutilizables para mejorar la eficiencia del desarrollo",
        "Implementé diseños responsivos asegurando una visualización óptima en todos los dispositivos",
        "Utilicé herramientas modernas de desarrollo incluyendo Webpack y Git para control de versiones",
        "Construí y mantuve sitios WordPress con temas y funcionalidades personalizadas",
      ],
