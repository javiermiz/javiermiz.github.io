      tech_stack: [
        "React",
        "Angular",
        "Ionic",
        "Firebase",
        "Google Maps API",
        "WordPress",
      ],
      key_contributions: [
        "Construí un sistema de reservas para restaurantes basado en React manejando reservaciones diarias",
        "Desarrollé una aplicación de seguimiento de entregas usando Angular/Ionic y Firebase",
