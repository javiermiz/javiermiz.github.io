---
// Dynamic blog post page
import { getCollection, type CollectionEntry } from "astro:content";
import BlogPostTemplate from "../../components/templates/blog-post-template.astro";

// Generate static paths for English blog posts only
export async function getStaticPaths() {
  const blog_posts = await getCollection("blog");
  // Filter only English posts (those that don't start with "es/")
  const english_posts = blog_posts.filter((post) => !post.slug.startsWith("es/"));
  
  return english_posts.map((post) => {
    return {
      params: { slug: post.slug },
      props: { post },
    };
  });
}

// Define props interface
interface Props {
  post: CollectionEntry<"blog">;
}

// Get the post from props
const { post } = Astro.props as Props;
---

<BlogPostTemplate
  post={post}
  language="en"
  back_link_url="/"
  back_link_text="Back to Blog"
  updated_text="Last updated"
/>
