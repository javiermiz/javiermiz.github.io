---
import BioLayout from "@components/BioLayout.astro";
import products from "@data/products.json";

const codeMap = Object.fromEntries(
  (products as any[]).map((p: any) => [p.code, p.slug])
);
---

<BioLayout title="Javier Miz" bg="#0a0a0a">
  <main class="bio">
    <div class="bio-inner">
      <h1 class="bio-title">Javier Miz</h1>
      <p class="bio-sub">Ingresa un código para ver el producto</p>

      <form class="bio-search" data-bio-form>
        <input
          id="bio-search-input"
          class="bio-input"
          type="search"
          placeholder="Escribe un código..."
          autocomplete="off"
          inputmode="search"
        />
        <button type="submit" class="bio-btn">Buscar</button>
      </form>

      <p class="bio-label">Códigos</p>

      <div class="bio-tags" data-bio-codes>
        {(products as any[]).map((product: any) => (
          <a
            href={`/bio/${product.slug}`}
            class="bio-tag"
            data-code={product.code}
          >
            {product.code}
          </a>
        ))}
      </div>

      <p class="bio-empty" data-bio-empty hidden>Código no encontrado</p>
    </div>
  </main>
</BioLayout>

<script
  is:inline
  define:vars={{ codeMap: JSON.stringify(codeMap) }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("[data-bio-form]");
    const input = document.querySelector("#bio-search-input");
    if (!(input instanceof HTMLInputElement)) return;

    const tags = Array.from(document.querySelectorAll("[data-code]"));
    const empty = document.querySelector("[data-bio-empty]");
    const parsed = JSON.parse(codeMap);

    if (form) form.addEventListener("submit", (e) => {
      e.preventDefault();
      const slug = parsed[input.value.trim().toUpperCase()];
      if (slug) window.location.href = `/bio/${slug}`;
    });

    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      tags.forEach((tag) => {
        const match = !q || tag.dataset.code.toLowerCase().includes(q);
        tag.hidden = !match;
        if (match) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .bio {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.25rem;
    padding-top: max(1.5rem, env(safe-area-inset-top));
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }

  .bio-inner {
    width: 100%;
    max-width: 400px;
  }

  .bio-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }

  .bio-sub {
    font-size: 0.7rem;
    color: #555;
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .bio-search {
    display: flex;
    margin-bottom: 1.75rem;
  }

  .bio-input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 0.85rem;
    border: 1px solid #222;
    border-right: none;
    border-radius: 10px 0 0 10px;
    background: #141414;
    color: #e5e5e5;
    font-size: 0.85rem;
    -webkit-appearance: none;
  }

  .bio-input::placeholder { color: #444; }
  .bio-input:focus { border-color: #555; }

  .bio-btn {
    height: 48px;
    padding: 0 1.1rem;
    border: 1px solid #e5e5e5;
    border-radius: 0 10px 10px 0;
    background: #e5e5e5;
    color: #0a0a0a;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
    -webkit-appearance: none;
  }

  .bio-btn:hover { background: #fff; }
  .bio-btn:active { opacity: 0.85; }

  .bio-label {
    font-size: 0.6rem;
    color: #444;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .bio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .bio-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid #222;
    border-radius: 10px;
    background: #141414;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ccc;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .bio-tag:hover {
    border-color: #e5e5e5;
    background: #1a1a1a;
    color: #fff;
  }

  .bio-tag:active { transform: scale(0.97); }

  .bio-empty {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: #444;
    text-align: center;
  }

  @media (min-width: 768px) {
    .bio { padding: 2rem; }
    .bio-title { font-size: 1.75rem; }
    .bio-sub { font-size: 0.8rem; margin-bottom: 2.25rem; }
    .bio-input { font-size: 0.9rem; height: 52px; }
    .bio-btn { font-size: 0.85rem; height: 52px; padding: 0 1.5rem; }
    .bio-tag { font-size: 0.85rem; padding: 0.6rem 1.25rem; }
  }

  @media (min-width: 1024px) {
    .bio-inner { max-width: 440px; }
    .bio-title { font-size: 2rem; }
  }
</style>
