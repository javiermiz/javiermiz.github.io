---
import "@components/bio-page.css";

import Layout from "@components/Layout.astro";
import products from "@data/products.json";

const codeMap = Object.fromEntries(
  (products as any[]).map((p: any) => [p.code, p.slug])
);
---

<Layout
  lang="en"
  title="Javier Miz - Creator Links"
  description="Link in bio page for content creation."
  hide_header={true}
  hide_footer={true}
  disable_main_padding={true}
>
  <div class="bio-page">
    <section class="bio-section">
      <div class="bio-container">
        <div class="bio-header">
          <h1 class="bio-title">Javier Miz</h1>
        </div>

        <form class="bio-search" role="search" data-bio-form>
          <input
            id="bio-search-input"
            class="bio-search-input"
            type="search"
            name="q"
            placeholder="Escribe un código..."
            autocomplete="off"
            inputmode="search"
          />
          <button type="submit" class="bio-search-btn">Buscar</button>
        </form>

        <p class="bio-section-label">Códigos recientes</p>

        <div class="bio-codes" data-bio-codes>
          {(products as any[]).map((product: any) => (
            <a
              href={`/${product.slug}`}
              class="bio-code-tag"
              data-code={product.code}
              data-goatcounter-click={`bio-code-${product.slug}`}
              data-goatcounter-title={`Código: ${product.code}`}
            >
              {product.code}
            </a>
          ))}
        </div>

        <div class="bio-empty" data-bio-empty hidden>Código no encontrado</div>
      </div>
    </section>
  </div>
</Layout>

<script
  is:inline
  define:vars={{ codeMap: JSON.stringify(codeMap) }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("[data-bio-form]");
    const input = document.querySelector("#bio-search-input");
    if (!(input instanceof HTMLInputElement)) return;

    const tags = Array.from(document.querySelectorAll("[data-code]"));
    const empty = document.querySelector("[data-bio-empty]");
    const parsed = JSON.parse(codeMap);

    const checkRedirect = (value) => {
      const slug = parsed[value.trim().toUpperCase()];
      if (slug) {
        window.location.href = `/${slug}`;
        return true;
      }
      return false;
    };

    const handleSubmit = (e) => {
      e.preventDefault();
      checkRedirect(input.value);
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      tags.forEach((tag) => {
        const match = !q || tag.dataset.code.toLowerCase().includes(q);
        tag.hidden = !match;
        if (match) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    };

    if (form) form.addEventListener("submit", handleSubmit);
    input.addEventListener("input", filter);
  });
</script>
