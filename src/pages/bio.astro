---
import "@components/bio-page.css";

import Layout from "@components/Layout.astro";
import MaonoPd200w from "@components/bio-items/maono-pd200w/maono-pd200w.astro";
import AulaF75 from "@components/bio-items/aula-f75/aula-f75.astro";
---

<Layout
  lang="en"
  title="Javier Miz - Creator Links"
  description="Link in bio page for content creation."
  hide_header={true}
  hide_footer={true}
>
  <section class="bio-page" aria-label="Creator links">
    <div class="bio-header">
      <h1 class="bio-title">Javier Miz</h1>
    </div>

    <div class="bio-search" role="search">
      <label class="bio-search-label" for="bio-search-input">Buscar</label>
      <input
        id="bio-search-input"
        class="bio-search-input"
        type="search"
        name="q"
        placeholder="Buscar links..."
        autocomplete="off"
        inputmode="search"
      />
    </div>

    <div class="bio-links" data-bio-links>
      <div
        data-bio-item
        data-search="maono pd200w microfono inalámbrico usb-c xlr"
      >
        <MaonoPd200w />
      </div>
      <AulaF75 />
    </div>

    <div class="bio-empty" data-bio-empty hidden>No results.</div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const search_input = document.querySelector("#bio-search-input");
    if (!(search_input instanceof HTMLInputElement)) return;

    const empty_element = document.querySelector("[data-bio-empty]");
    const item_elements = Array.from(
      document.querySelectorAll("[data-bio-item], [data-search]"),
    ).filter((item) => item instanceof HTMLElement);

    if (item_elements.length === 0) return;

    const normalize = (text: string) =>
      text
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const update = () => {
      const normalized_query = normalize(search_input.value);

      let visible_count = 0;
      item_elements.forEach((item) => {
        const search_text = normalize(item.dataset.search || "");
        const is_visible =
          normalized_query.length === 0 ||
          search_text.includes(normalized_query);

        item.hidden = !is_visible;
        if (is_visible) visible_count += 1;
      });

      if (empty_element instanceof HTMLElement) {
        empty_element.hidden = visible_count > 0;
      }
    };

    search_input.addEventListener("input", update);
    update();
  });
</script>
