---
import Layout from "./Layout.astro";
import Image from "astro/components/Image.astro";
import {
  Mail,
  MapPin,
  Clock,
  ArrowRight,
  Briefcase,
  Languages,
  BookOpen,
  GraduationCap,
  FolderGit2,
} from "lucide-react";

export interface Props {
  lang: "en" | "es";
  title: string;
  data: any; // CV_DATA from locale
}

const { lang, title, data } = Astro.props;
const CV_DATA = data;
---

<Layout lang={lang} title={title}>
  <main class="max-w-4xl mx-auto p-3 lg:px-4 lg:py-8">
    {/* Profile Header */}
    <section
      class="bg-white dark:bg-zinc-900 border border-black dark:border-zinc-600 rounded-lg p-4 lg:p-6 space-y-4"
    >
      <div class="flex flex-row gap-4 lg:gap-6 items-start">
        {/* Avatar */}
        <div
          class="w-16 h-16 lg:w-24 lg:h-24 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-400 dark:text-zinc-500 overflow-hidden shrink-0"
        >
          <Image
            class="w-full h-full object-cover"
            src="/profile-og.jpg"
            alt="Javier Miz"
            width="96"
            height="96"
          />
        </div>

        {/* Info */}
        <div class="flex-1 space-y-2 min-w-0">
          <div class="flex items-center gap-3 text-sm">
            <span
              class="flex items-center gap-1 text-green-600 dark:text-green-400 font-medium"
            >
              <Clock className="w-3 h-3" />
              {CV_DATA.profile.availability}
            </span>
          </div>

          <div>
            <h1
              class="text-2xl lg:text-3xl font-bold text-zinc-900 dark:text-white font-primary"
            >
              {CV_DATA.profile.name}
            </h1>
            <p
              class="text-lg lg:text-xl text-zinc-800 dark:text-zinc-200 mt-0.5"
            >
              {CV_DATA.profile.role}
            </p>
          </div>

          <div class="flex gap-3 text-sm text-zinc-600 dark:text-zinc-400">
            <span
              class="font-medium text-amber-600 dark:text-amber-400 flex items-center gap-1.5"
            >
              <MapPin className="w-4 h-4" />
              {CV_DATA.profile.location}
            </span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t dark:border-zinc-800">
        {/* Navigation Buttons */}
        <nav class="flex flex-wrap gap-2" aria-label="Page sections">
          <a
            href="#expertise"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 rounded-lg text-sm border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors shadow-sm"
          >
            <Briefcase className="w-4 h-4" />
            {CV_DATA.ui.sections.skills}
          </a>
          <a
            href="#projects"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 rounded-lg text-sm border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors shadow-sm"
          >
            <FolderGit2 className="w-4 h-4" />
            {CV_DATA.ui.sections.projects}
          </a>
          <a
            href="#experience"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 rounded-lg text-sm border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors shadow-sm"
          >
            <BookOpen className="w-4 h-4" />
            {CV_DATA.ui.sections.experience}
          </a>
          <a
            href="#education"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 rounded-lg text-sm border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors shadow-sm"
          >
            <GraduationCap className="w-4 h-4" />
            {CV_DATA.ui.sections.education}
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t dark:border-zinc-800 space-y-3">
        {/* Headline */}
        <div class="space-y-1">
          <h2
            class="text-lg lg:text-xl font-bold text-zinc-900 dark:text-white"
          >
            {CV_DATA.profile.headline}
          </h2>
          <p class="text-base lg:text-lg text-zinc-800 dark:text-zinc-200">
            {CV_DATA.profile.subheadline}
          </p>
        </div>

        {/* Key Achievements */}
        <div class="space-y-2">
          <h3 class="text-base font-semibold text-zinc-800 dark:text-zinc-200">
            {CV_DATA.ui.labels.keyAchievements}
          </h3>
          <ul class="space-y-1.5">
            {
              CV_DATA.highlights.map((highlight: string) => (
                <li class="flex gap-2 text-zinc-700 dark:text-zinc-300">
                  <ArrowRight className="w-4 h-4 mt-0.5 shrink-0" />
                  <span class="text-sm leading-relaxed">{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {/* About */}
        <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
          {CV_DATA.profile.about}
        </p>
      </div>

      {/* Expertise */}
      <div id="expertise" class="pt-4 border-t dark:border-zinc-800 space-y-4">
        <h2
          class="flex gap-2 items-center text-lg lg:text-xl font-bold text-zinc-900 dark:text-white"
        >
          <Briefcase className="w-5 h-5" />
          {CV_DATA.ui.sections.skills}
        </h2>

        <div class="space-y-4">
          {/* Technical Skills */}
          <div>
            <h3
              class="font-semibold dark:text-zinc-300 mb-3"
            >
              {CV_DATA.ui.labels.technicalSkills}
            </h3>
            <div class="flex flex-wrap gap-2 pl-4">
              {
                CV_DATA.expertise.technical_skills.map((skill: any, index: number) => (
                  <>
                    <span class="flex items-center gap-2">
                      <span class="text-sm font-medium text-zinc-900 dark:text-white">
                        {skill.name}
                      </span>
                      <span class="text-xs text-zinc-700 dark:text-zinc-300">
                        {skill.level}
                      </span>
                    </span>
                    {index < CV_DATA.expertise.technical_skills.length - 1 && (
                      <span class="text-zinc-400 dark:text-zinc-600 mx-1">•</span>
                    )}
                  </>
                ))
                }
            </div>
          </div>

          {/* Soft Skills */}
          <div>
            <h3
              class="font-semibold dark:text-zinc-300 mb-2"
            >
              {CV_DATA.ui.labels.professionalSkills}
            </h3>
            <div class="flex flex-wrap gap-1.5 pl-4">
              {
                CV_DATA.expertise.soft_skills.map((skill: string, index: number) => (
                  <>
                    <span class="text-sm font-medium text-zinc-900 dark:text-white">
                      {skill}
                    </span>
                    {index < CV_DATA.expertise.soft_skills.length - 1 && (
                      <span class="text-zinc-400 dark:text-zinc-600 mx-1">•</span>
                    )}
                  </>
                ))
              }
            </div>
          </div>

          {/* Tools & Platforms */}
          <div>
            <h3
              class="font-semibold dark:text-zinc-300 mb-2"
            >
              {CV_DATA.ui.labels.toolsPlatforms}
            </h3>
            <div class="flex flex-wrap gap-1.5 pl-4">
              {
                CV_DATA.expertise.tools_platforms.map((tool: string, index: number) => (
                  <>
                    <span class="text-sm font-medium text-zinc-900 dark:text-white">
                      {tool}
                    </span>
                    {index < CV_DATA.expertise.tools_platforms.length - 1 && (
                      <span class="text-zinc-400 dark:text-zinc-600 mx-1">•</span>
                    )}
                  </>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Projects */}
    <section
      id="projects"
      class="mt-4 bg-white dark:bg-zinc-900 border border-black dark:border-zinc-700 rounded-lg p-4 lg:p-6 space-y-4"
    >
      <h2 class="text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white">
        {CV_DATA.ui.labels.recentProjects}
      </h2>
      <div class="divide-y dark:divide-zinc-800 space-y-3">
        {
          CV_DATA.projects.map((project: any) => (
            <div class="pt-3 first:pt-0">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="space-y-1 min-w-0">
                  <h3 class="text-lg font-bold text-zinc-900 dark:text-white">
                    {project.name}
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400">
                    {project.involvement}
                  </p>
                  {project.note && (
                    <p class="text-xs text-zinc-500 dark:text-zinc-500 italic mt-1">
                      {project.note}
                    </p>
                  )}
                </div>
                {project.url && (
                  <a
                    href={project.url}
                    class="inline-flex items-center justify-between gap-1.5 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-md hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0 lg:text-sm"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.buttonText || CV_DATA.ui.labels.viewProject}
                    <ArrowRight className="w-3 h-3 ml-auto" />
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* Experience */}
    <section
      id="experience"
      class="mt-4 bg-white dark:bg-zinc-900 border border-black dark:border-zinc-700 rounded-lg p-4 lg:p-6 space-y-4"
    >
      <h2 class="text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white">
        {CV_DATA.ui.labels.workExperience}
      </h2>
      <div class="divide-y dark:divide-zinc-800 space-y-1">
        {
          CV_DATA.experience.map((job: any) => (
            <div class="py-4 first:pt-0 last:pb-0 space-y-3">
              <div class="flex justify-between items-start gap-3">
                <div class="min-w-0">
                  <h3 class="text-lg lg:text-xl font-bold text-zinc-900 dark:text-white">
                    {job.company}
                  </h3>
                  <p class="text-base text-zinc-800 dark:text-zinc-200 mt-0.5">
                    {job.role}
                  </p>
                  {job.location && (
                    <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                      {job.location}
                    </p>
                  )}
                </div>
                <div class="text-right shrink-0">
                  <span class="text-sm text-zinc-600 dark:text-zinc-400">
                    {job.period}
                  </span>
                  {job.current && (
                    <div class="mt-1">
                      <span class="px-2 py-0.5 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-xs font-medium rounded">
                        {CV_DATA.ui.labels.current}
                      </span>
                    </div>
                  )}
                </div>
              </div>

              {/* Impact Summary */}
              <div class="bg-zinc-50 dark:bg-zinc-800 p-3 rounded-md">
                <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
                  {job.impact_summary}
                </p>
              </div>

              {/* Tech Stack */}
              <div class="flex flex-wrap gap-1.5">
                {job.tech_stack.map((tech: string) => (
                  <span class="px-2 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium rounded">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Key Contributions */}
              <ul class="space-y-2">
                {job.key_contributions.map((contribution: string) => (
                  <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
                    <ArrowRight className="w-4 h-4 mt-0.5 shrink-0" />
                    <span class="text-sm leading-relaxed">
                      {contribution}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {/* Education */}
    <section
      id="education"
      class="mt-4 bg-white dark:bg-zinc-900 border border-black dark:border-zinc-700 rounded-lg p-4 lg:p-6"
    >
      <h2
        class="text-xl lg:text-2xl font-bold text-zinc-900 dark:text-white mb-3"
      >
        {CV_DATA.ui.sections.education}
      </h2>
      <div class="space-y-2">
        <h3 class="text-lg font-bold text-zinc-800 dark:text-zinc-200">
          {CV_DATA.education.degree}
        </h3>
        <p class="text-base text-zinc-700 dark:text-zinc-300">
          {CV_DATA.education.institution}
        </p>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          {CV_DATA.education.year}
        </p>
        <p
          class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed mt-3"
        >
          {CV_DATA.education.relevance}
        </p>
      </div>
    </section>

    <style>
      #expertise,
      #experience,
      #projects,
      #education {
        scroll-margin-top: 2rem;
      }
    </style>
  </main>
</Layout> 