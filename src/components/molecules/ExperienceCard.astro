---
import { ArrowRight } from "lucide-react";

export interface Props {
  icon?: string;
  company: string;
  role: string;
  location?: string;
  period: string;
  current?: boolean;
  currentLabel: string;
  impactSummary: string;
  techStack: string[];
  keyContributions: string[];
}

const {
  icon,
  company,
  role,
  location,
  period,
  current = false,
  currentLabel,
  impactSummary,
  techStack,
  keyContributions,
} = Astro.props;
---

<div class="py-4 first:pt-0 last:pb-0 space-y-3">
  <div class="flex justify-between items-start gap-3">
    <div class="min-w-0">
      <h3
        class="text-lg lg:text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2"
      >
        {icon && <img src={icon} alt={company} class="w-8" />}
        {company}
      </h3>
      <p class="text-base text-zinc-800 dark:text-zinc-200 mt-0.5">
        {role}
      </p>
      {
        location && (
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            {location}
          </p>
        )
      }
    </div>
    <div class="text-right shrink-0">
      <span class="text-sm text-zinc-600 dark:text-zinc-400">
        {period}
      </span>
      {
        current && (
          <div class="mt-1">
            <span class="px-2 py-0.5 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-xs font-medium rounded">
              {currentLabel}
            </span>
          </div>
        )
      }
    </div>
  </div>

  {/* Impact Summary */}
  <div class="bg-zinc-50 dark:bg-zinc-800 p-3 rounded-md">
    <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
      {impactSummary}
    </p>
  </div>

  {/* Tech Stack */}
  <div class="flex flex-wrap gap-1.5">
    {
      techStack.map((tech: string) => (
        <span class="px-2 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium rounded">
          {tech}
        </span>
      ))
    }
  </div>

  {/* Key Contributions */}
  <ul class="space-y-2">
    {
      keyContributions.map((contribution: string) => (
        <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
          <ArrowRight className="w-4 h-4 mt-0.5 shrink-0" />
          <span class="text-sm leading-relaxed">{contribution}</span>
        </li>
      ))
    }
  </ul>
</div>
