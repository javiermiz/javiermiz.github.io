---
import { ArrowRight } from "lucide-react";

export interface Props {
  icon?: string;
  company: string;
  role: string;
  location?: string;
  period: string;
  current?: boolean;
  currentLabel: string;
  impactSummary: string;
  techStack: string[];
  keyContributions: string[];
}

const {
  icon,
  company,
  role,
  location,
  period,
  current = false,
  currentLabel,
  impactSummary,
  techStack,
  keyContributions,
} = Astro.props;
---

<div>
  <div>
    <div>
      <h3>
        {icon && <img src={icon} alt={company} />}
        {company}
      </h3>
      <p>
        {role}
      </p>
      {
        location && (
          <p>
            {location}
          </p>
        )
      }
    </div>
    <div>
      <span>
        {period}
      </span>
      {
        current && (
          <div>
            <span>
              {currentLabel}
            </span>
          </div>
        )
      }
    </div>
  </div>

  {/* Impact Summary */}
  <div>
    <p>
      {impactSummary}
    </p>
  </div>

  {/* Tech Stack */}
  <div>
    {
      techStack.map((tech: string) => (
        <span>
          {tech}
        </span>
      ))
    }
  </div>

  {/* Key Contributions */}
  <ul>
    {
      keyContributions.map((contribution: string) => (
        <li>
          <ArrowRight />
          <span>{contribution}</span>
        </li>
      ))
    }
  </ul>
</div>
