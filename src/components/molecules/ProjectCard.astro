---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide-react";
export interface Props {
  icon: string;
  name: string;
  involvement: string;
  note?: string;
  url?: string;
  buttonText?: string;
  defaultButtonText: string;
}

const { icon, name, involvement, note, url, buttonText, defaultButtonText } =
  Astro.props;
---

<div>
  <div>
    <div>
      <h3>
        {
          icon && (
            <div>
              <img src={icon} alt={name} />
            </div>
          )
        }
        {name}
      </h3>
      <p>
        {involvement}
      </p>
      {
        note && (
          <p>
            {note}
          </p>
        )
      }
    </div>
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {buttonText || defaultButtonText}
          <ArrowRight />
        </a>
      )
    }
  </div>
</div>
