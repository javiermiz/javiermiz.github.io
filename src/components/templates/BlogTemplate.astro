---
import { getCollection } from 'astro:content';
import Layout from '../Layout.astro';

interface Props {
  blog_data: any;
  lang: 'en' | 'es';
}

const { blog_data, lang } = Astro.props;

// Get all blog posts and filter by language (based on folder structure) and draft status
const all_posts = await getCollection('blog', (entry) => {
  const post_language = entry.slug.startsWith('es/') ? 'es' : 'en';
  return post_language === lang && !entry.data.draft;
});
const published_posts = all_posts;

// Sort posts by publication date (newest first)
const sorted_posts = published_posts.sort((a, b) => 
  new Date(b.data.published_date).getTime() - new Date(a.data.published_date).getTime()
);

// Get unique categories
const all_categories = [...new Set(sorted_posts.map(post => post.data.category))];
---

<Layout 
  title={blog_data.metadata.title}
  description={blog_data.metadata.description}
  lang={lang}
>
  <div class="min-h-screen">

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto">
      <!-- Posts Grid -->
      {sorted_posts.length > 0 ? (
        <div id="posts-container" class="grid gap-6">
          {sorted_posts.map(post => {
            const category_label = blog_data.categories[post.data.category as keyof typeof blog_data.categories] || post.data.category;
            
            return (
              <a href={lang === 'es' ? `/es/blog/${post.slug.replace('es/', '')}/` : `/blog/${post.slug}/`} class="block hover:text-red-700 transition-colors duration-200 post-item" data-category={post.data.category}>
                <article class="">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs text-gray-500 uppercase tracking-wide">
                      {category_label}
                    </span>
                    <time class="text-xs text-gray-400" datetime={post.data.published_date.toISOString()}>
                      {new Date(post.data.published_date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                  </div>
                  
                  <h2 class="text-lg font-medium text-gray-900 mb-1">
                    {post.data.title}
                  </h2>
                  
                  <p class="text-sm text-gray-600">
                    {post.data.description}
                  </p>
                </article>
              </a>
            );
          })}
        </div>
      ) : (
        <!-- No Results Message -->
        <div id="no-results" class="text-center py-12">
          <div class="text-gray-500">

            <h3 class="text-lg font-medium text-gray-900 mb-2">{blog_data.ui.no_results_title}</h3>
            <p class="text-gray-500">{blog_data.ui.no_results_message}</p>
          </div>
        </div>
      )}
    </main>
  </div>

  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</Layout>