---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../Layout.astro";

type BlogPost = CollectionEntry<"blog">;

interface Props {
  blog_data: any;
}

const { blog_data } = Astro.props;

function format_post_date(date: Date): string {
  // Use UTC timezone to avoid date shifts from frontmatter dates
  return new Intl.DateTimeFormat("es-ES", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
}

function get_category_label(category: string, categories_data: any): string {
  return categories_data[category] || category;
}

// Get published blog posts, newest first
const published_posts = await getCollection(
  "blog",
  (entry: BlogPost) => !entry.data.draft,
);
const sorted_posts = published_posts.sort(
  (a, b) =>
    b.data.published_date.getTime() - a.data.published_date.getTime(),
);
const has_posts = sorted_posts.length > 0;
---

<Layout
  title={blog_data.metadata.title}
  description={blog_data.metadata.description}
>
  <div class="blog-container">
    <main class="blog-main">
      {
        has_posts && (
          <div id="posts-container" class="posts-grid">
            {sorted_posts.map((post) => {
              const category_label = get_category_label(
                post.data.category,
                blog_data.categories,
              );
              const post_url = `/blog/${post.slug}/`;
              const formatted_date = format_post_date(
                post.data.published_date,
              );

              return (
                <a
                  href={post_url}
                  class="post-item"
                  data-category={post.data.category}
                >
                  <article class="post-article">
                    <div class="post-meta">
                      <span class="post-category">{category_label}</span>
                      <time
                        class="post-date"
                        datetime={post.data.published_date.toISOString()}
                      >
                        {formatted_date}
                      </time>
                    </div>

                    <h2 class="post-title">{post.data.title}</h2>

                    <p class="post-description">{post.data.description}</p>
                  </article>
                </a>
              );
            })}
          </div>
        )
      }

      {
        !has_posts && (
          <div id="no-results" class="no-results">
            <div class="no-results-content">
              <h3 class="no-results-title">{blog_data.ui.no_results_title}</h3>
              <p class="no-results-message">
                {blog_data.ui.no_results_message}
              </p>
            </div>
          </div>
        )
      }
    </main>
  </div>
</Layout>

<style>
  /* Blog Template Styles */

  .blog-main {
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }

  .posts-grid {
    display: grid;
    gap: var(--space-6);
  }

  .post-item {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-normal);
    border-color: var(--color-text-light);
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: var(--space-4);
  }

  .post-article {
    /* Article styling handled by global styles */
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .post-category {
    text-transform: capitalize;
    font-size: var(--text-xs);
    color: var(--color-primary);
    letter-spacing: 0.05em;
    font-weight: var(--font-medium);
  }

  .post-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  .post-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* No Results State */
  .no-results {
    text-align: center;
    padding: var(--space-12) 0;
  }

  .no-results-content {
    color: var(--color-text-secondary);
  }

  .no-results-title {
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .no-results-message {
    color: var(--color-text-secondary);
  }

  /* Utility Classes */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
