---
import Layout from "@components/Layout.astro";

export interface Props {
  data: any; // CV_DATA from locale
}

const { data } = Astro.props;
const CV_DATA = data;
---

<main class="cv-content">
  <!-- Profile Header -->
  <section class="profile-section">
    <div class="profile-info">
      <h1>{CV_DATA.profile.name}</h1>
      <p class="role">{CV_DATA.profile.role}</p>
      <p class="location">{CV_DATA.profile.location}</p>
      <p class="availability">{CV_DATA.profile.availability}</p>
    </div>

    <!-- Simple Navigation -->
    <nav class="section-nav">
      <a href="#expertise">{CV_DATA.ui.sections.skills}</a>
      <a href="#projects">{CV_DATA.ui.sections.projects}</a>
      <a href="#experience">{CV_DATA.ui.sections.experience}</a>
      <a href="#education">{CV_DATA.ui.sections.education}</a>
    </nav>

    <!-- Headline -->
    <div class="headline-section">
      <h2>{CV_DATA.profile.headline}</h2>
      <p>{CV_DATA.profile.subheadline}</p>
    </div>

    <!-- Key Achievements -->
    <div class="achievements-section">
      <h3>{CV_DATA.ui.labels.keyAchievements}</h3>
      <ul>
        {CV_DATA.highlights.map((highlight: string) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </div>

    <!-- About -->
    <p class="about-text">{CV_DATA.profile.about}</p>
  </section>

  <!-- Expertise -->
  <section id="expertise" class="expertise-section">
    <h2>{CV_DATA.ui.sections.skills}</h2>

    <!-- Technical Skills -->
    <div class="skills-group">
      <h3>{CV_DATA.ui.labels.technicalSkills}</h3>
      <ul class="skills-list">
        {CV_DATA.expertise.technical_skills.map((skill: any) => (
          <li>
            {skill.name}
            {skill.level && <span class="skill-level"> - {skill.level}</span>}
          </li>
        ))}
      </ul>
    </div>

    <!-- Soft Skills -->
    <div class="skills-group">
      <h3>{CV_DATA.ui.labels.professionalSkills}</h3>
      <ul class="skills-list">
        {CV_DATA.expertise.soft_skills.map((skill: string) => (
          <li>{skill}</li>
        ))}
      </ul>
    </div>

    <!-- Tools & Platforms -->
    <div class="skills-group">
      <h3>{CV_DATA.ui.labels.toolsPlatforms}</h3>
      <ul class="skills-list">
        {CV_DATA.expertise.tools_platforms.map((tool: string) => (
          <li>{tool}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="projects-section">
    <h2>{CV_DATA.ui.labels.recentProjects}</h2>
    <div class="projects-list">
      {CV_DATA.projects.map((project: any) => (
        <div class="project-item">
          <h3>{project.name}</h3>
          <p>{project.involvement}</p>
          {project.note && <p class="project-note">{project.note}</p>}
          {project.url && (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link">
              {project.buttonText || CV_DATA.ui.labels.viewProject}
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="experience-section">
    <h2>{CV_DATA.ui.labels.workExperience}</h2>
    <div class="experience-list">
      {CV_DATA.experience.map((job: any) => (
        <div class="experience-item">
          <div class="job-header">
            <h3>{job.company}</h3>
            <p class="job-role">{job.role}</p>
            {job.location && <p class="job-location">{job.location}</p>}
            <p class="job-period">
              {job.period}
              {job.current && <span class="current-label"> - {CV_DATA.ui.labels.current}</span>}
            </p>
          </div>
          
          <p class="impact-summary">{job.impact_summary}</p>
          
          <div class="tech-stack">
            <strong>Tech Stack:</strong>
            {job.tech_stack.map((tech: string, index: number) => (
              <span>
                {tech}
                {index < job.tech_stack.length - 1 && ", "}
              </span>
            ))}
          </div>
          
          <ul class="contributions-list">
            {job.key_contributions.map((contribution: string) => (
              <li>{contribution}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="education-section">
    <h2>{CV_DATA.ui.sections.education}</h2>
    <div class="education-item">
      <h3>{CV_DATA.education.degree}</h3>
      <p>{CV_DATA.education.institution}</p>
      <p>{CV_DATA.education.year}</p>
      <p>{CV_DATA.education.relevance}</p>
    </div>
  </section>
</main>

<style>
  /* Minimal CSS following the project vision */
  .cv-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.6;
    color: #333333;
  }

  h1, h2, h3 {
    font-family: Inter, 'Helvetica Neue', sans-serif;
    color: #000000;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #F5F5F5;
    padding-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .role {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .location, .availability {
    color: #666666;
    margin-bottom: 0.25rem;
  }

  .section-nav {
    margin: 2rem 0;
    padding: 1rem 0;
    border-top: 1px solid #F5F5F5;
    border-bottom: 1px solid #F5F5F5;
  }

  .section-nav a {
    color: #DC2626;
    text-decoration: none;
    margin-right: 2rem;
  }

  .section-nav a:hover {
    color: #B91C1C;
    text-decoration: underline;
  }

  .headline-section {
    margin: 2rem 0;
  }

  .achievements-section {
    margin: 2rem 0;
  }

  .achievements-section ul {
    list-style-type: disc;
    margin-left: 1.5rem;
  }

  .about-text {
    margin: 2rem 0;
    font-style: italic;
  }

  .skills-group {
    margin-bottom: 2rem;
  }

  .skills-list {
    list-style-type: disc;
    margin-left: 1.5rem;
  }

  .skill-level {
    color: #666666;
    font-size: 0.9rem;
  }

  .project-item {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #F5F5F5;
  }

  .project-note {
    font-style: italic;
    color: #666666;
  }

  .project-link {
    color: #DC2626;
    text-decoration: none;
  }

  .project-link:hover {
    color: #B91C1C;
    text-decoration: underline;
  }

  .experience-item {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #F5F5F5;
  }

  .job-role {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .job-location, .job-period {
    color: #666666;
    margin-bottom: 0.25rem;
  }

  .current-label {
    color: #DC2626;
    font-weight: 600;
  }

  .impact-summary {
    margin: 1rem 0;
    font-style: italic;
  }

  .tech-stack {
    margin: 1rem 0;
    color: #666666;
  }

  .contributions-list {
    list-style-type: disc;
    margin-left: 1.5rem;
    margin-top: 1rem;
  }

  .education-item {
    margin-bottom: 1rem;
  }

  /* Scroll margin for anchor links */
  #expertise,
  #experience,
  #projects,
  #education {
    scroll-margin-top: 2rem;
  }
</style>
