---
export interface Props {
  data: any; // CV_DATA from locale
}

const { data } = Astro.props;
const CV_DATA = data;
---

<main class="cv-main">
  <!-- Profile Header -->
  <section class="cv-profile">
    <div class="profile-header">
      <div class="profile-info">
        <h1 class="profile-name">
          {CV_DATA.profile.name}
        </h1>
        <p class="profile-role">{CV_DATA.profile.role}</p>
      </div>
      <div class="profile-details">
        <p class="profile-location">{CV_DATA.profile.location}</p>
        <p class="profile-availability">{CV_DATA.profile.availability}</p>
      </div>
    </div>

    <!-- Simple Navigation -->
    <nav class="cv-nav">
      <a href="#expertise" class="cv-nav-link">
        {CV_DATA.ui.sections.skills}
      </a>
      <a href="#projects" class="cv-nav-link">
        {CV_DATA.ui.sections.projects}
      </a>
      <a href="#experience" class="cv-nav-link">
        {CV_DATA.ui.sections.experience}
      </a>
      <a href="#education" class="cv-nav-link">
        {CV_DATA.ui.sections.education}
      </a>
    </nav>

    <!-- Headline -->
    <div class="cv-headline">
      <h2 class="headline-title">
        {CV_DATA.profile.headline}
      </h2>
      <p class="headline-subtitle">{CV_DATA.profile.subheadline}</p>
    </div>

    <!-- Key Achievements -->
    <div class="cv-achievements">
      <h3 class="achievements-title">
        {CV_DATA.ui.labels.keyAchievements}
      </h3>
      <ul class="achievements-list">
        {CV_DATA.highlights.map((highlight: string) => <li>{highlight}</li>)}
      </ul>
    </div>

    <!-- About -->
    <p class="cv-about">{CV_DATA.profile.about}</p>
  </section>

  <!-- Expertise -->
  <section id="expertise" class="cv-section">
    <h2 class="section-title">
      {CV_DATA.ui.sections.skills}
    </h2>

    <!-- Technical Skills -->
    <div class="skill-group">
      <h3 class="skill-group-title">
        {CV_DATA.ui.labels.technicalSkills}
      </h3>
      <ul class="skill-list">
        {
          CV_DATA.expertise.technical_skills.map((skill: any) => (
            <li class="skill-item">
              {skill.name}
              {skill.level && <span class="skill-level"> - {skill.level}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Soft Skills -->
    <div class="skill-group">
      <h3 class="skill-group-title">
        {CV_DATA.ui.labels.professionalSkills}
      </h3>
      <ul class="skill-list">
        {
          CV_DATA.expertise.soft_skills.map((skill: string) => (
            <li class="skill-item">{skill}</li>
          ))
        }
      </ul>
    </div>

    <!-- Tools & Platforms -->
    <div class="skill-group">
      <h3 class="skill-group-title">
        {CV_DATA.ui.labels.toolsPlatforms}
      </h3>
      <ul class="skill-list">
        {
          CV_DATA.expertise.tools_platforms.map((tool: string) => (
            <li class="skill-item">{tool}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="cv-section">
    <h2 class="section-title">
      {CV_DATA.ui.labels.recentProjects}
    </h2>
    <div class="projects-container">
      {
        CV_DATA.projects.map((project: any) => (
          <div class="project-item">
            <div class="project-header">
              {project.icon && (
                <img
                  src={project.icon}
                  alt={`${project.name} icon`}
                  class="project-icon"
                />
              )}
              <h3 class="project-title">{project.name}</h3>
            </div>
            <p class="project-involvement">{project.involvement}</p>
            {project.note && <p class="project-note">{project.note}</p>}
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                {project.buttonText || CV_DATA.ui.labels.viewProject}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="cv-section">
    <h2 class="section-title">
      {CV_DATA.ui.labels.workExperience}
    </h2>
    <div class="experience-container">
      {
        CV_DATA.experience.map((job: any) => (
          <div class="experience-item">
            <div class="experience-header">
              <div class="experience-company-wrapper">
                {job.icon && (
                  <img 
                    src={job.icon} 
                    alt={`${job.company} logo`}
                    class="experience-icon"
                    loading="lazy"
                  />
                )}
                <div class="experience-text">
                  <h3 class="experience-company">{job.company}</h3>
                  <p class="experience-role">{job.role}</p>
                </div>
              </div>
              {job.location && (
                <p class="experience-location">{job.location}</p>
              )}
              <p class="experience-period">
                {job.period}
                {job.current && (
                  <span class="experience-current">
                    {" "}
                    - {CV_DATA.ui.labels.current}
                  </span>
                )}
              </p>
            </div>

            <p class="experience-summary">{job.impact_summary}</p>

            <div class="experience-tech">
              <strong>Tech Stack:</strong>
              {job.tech_stack.map((tech: string, index: number) => (
                <span>
                  {tech}
                  {index < job.tech_stack.length - 1 && ", "}
                </span>
              ))}
            </div>

            <ul class="experience-contributions">
              {job.key_contributions.map((contribution: string) => (
                <li class="contribution-item">{contribution}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="cv-section">
    <h2 class="section-title">
      {CV_DATA.ui.sections.education}
    </h2>
    <div class="education-item">
      <h3 class="education-degree">
        {CV_DATA.education.degree}
      </h3>
      <p class="education-institution">{CV_DATA.education.institution}</p>
      <p class="education-year">{CV_DATA.education.year}</p>
      <p class="education-relevance">{CV_DATA.education.relevance}</p>
    </div>
  </section>
</main>

<style>
  .cv-main {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-2);
    font-family: var(--font-serif-body);
    line-height: var(--line-height-normal);
    color: var(--color-text-primary);
  }

  /* Profile Header - Mobile First */
  .cv-profile {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--space-3);
    gap: var(--space-2);
  }

  .profile-name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
    font-family: var(--font-serif);
  }

  .profile-role {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .profile-details {
    text-align: left;
  }

  .profile-location,
  .profile-availability {
    margin: 0 0 var(--space-1) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  /* Navigation - Mobile First */
  .cv-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .cv-nav-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .cv-nav-link:hover {
    text-decoration: underline;
  }

  /* Headline - Mobile First */
  .cv-headline {
    margin-bottom: var(--space-3);
  }

  .headline-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: var(--line-height-tight);
  }

  .headline-subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Achievements - Mobile First */
  .cv-achievements {
    margin-bottom: var(--space-3);
  }

  .achievements-title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .achievements-list {
    list-style: disc;
    padding-left: var(--space-4);
    margin: 0;
  }

  .achievements-list li {
    margin-bottom: var(--space-1);

    color: var(--color-text-body);
  }

  /* About */
  .cv-about {
    line-height: var(--line-height-loose);
    color: var(--color-text-body);
    margin: 0;
  }

  /* Sections - Mobile First */
  .cv-section {
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
    font-family: var(--font-serif);
  }

  /* Skills - Mobile First */
  .skill-group {
    margin-bottom: var(--space-3);
  }

  .skill-group-title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-item {
    color: var(--color-text-body);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-sm);
  }

  .skill-level {
    color: var(--color-text-secondary);
  }

  /* Projects - Mobile First */
  .projects-container {
    display: grid;
    gap: var(--space-3);
  }

  .project-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .project-icon {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .project-title {
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .project-involvement {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
  }

  .project-note {
    font-style: italic;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
  }

  .project-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .project-link:hover {
    text-decoration: underline;
  }

  /* Experience - Mobile First */
  .experience-container {
    display: grid;
    gap: var(--space-3);
  }

  .experience-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .experience-header {
    margin-bottom: var(--space-2);
  }

  .experience-company-wrapper {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .experience-icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-secondary);
    padding: var(--space-1);
    flex-shrink: 0;
  }

  .experience-text {
    flex: 1;
    min-width: 0;
  }

  .experience-company {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
    font-family: var(--font-serif);
  }

  .experience-role {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1) 0;
  }

  .experience-location {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1) 0;
  }

  .experience-period {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: var(--text-sm);
  }

  .experience-current {
    color: var(--color-primary);
  }

  .experience-summary {
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-body);
    line-height: var(--line-height-loose);
  }

  .experience-tech {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--text-sm);
  }

  .experience-tech strong {
    color: var(--color-text-primary);
    margin-right: var(--space-1);
  }

  .experience-contributions {
    list-style: disc;
    padding-left: var(--space-4);
    margin: 0;
  }

  .contribution-item {
    margin-bottom: var(--space-1);
    color: var(--color-text-body);
  }

  /* Education - Simplified */
  .education-item {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .education-degree {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
    font-family: var(--font-serif);
  }

  .education-institution {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1) 0;
  }

  .education-year {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-sm);
  }

  .education-relevance {
    color: var(--color-text-body);
    line-height: var(--line-height-loose);
    margin: 0;
  }

  /* Responsive Design - Mobile First */
  @media (max-width: 480px) {
    .experience-company-wrapper {
      gap: var(--space-2);
    }

    .experience-icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (min-width: 481px) {
    .cv-main {
      padding: var(--space-3);
    }

    .cv-profile {
      margin-bottom: var(--space-6);
      padding-bottom: var(--space-4);
    }

    .profile-header {
      flex-direction: row;
      justify-content: space-between;
      margin-bottom: var(--space-4);
      gap: var(--space-3);
    }

    .profile-name {
      font-size: var(--text-xl);
    }

    .profile-role {
      font-size: var(--text-base);
    }

    .profile-details {
      text-align: right;
    }

    .cv-nav {
      flex-direction: row;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .cv-headline {
      margin-bottom: var(--space-4);
    }

    .headline-title {
      font-size: var(--text-lg);
    }

    .cv-achievements {
      margin-bottom: var(--space-4);
    }

    .achievements-title {
      font-size: var(--text-base);
    }

    .section-title {
      font-size: var(--text-xl);
    }

    .skill-group {
      margin-bottom: var(--space-4);
    }

    .skill-group-title {
      font-size: var(--text-base);
    }

    .projects-container,
    .experience-container {
      gap: var(--space-4);
    }

    .project-item,
    .experience-item {
      padding: var(--space-3) 0;
    }

    .experience-header {
      margin-bottom: var(--space-3);
    }

    .cv-section {
      margin-bottom: 3rem;
    }
  }

  @media (min-width: 769px) {
    .cv-main {
      padding: var(--space-6);
    }
  }

  /* Print Styles - Mobile First Optimized */
  @media print {
    .cv-main {
      max-width: none;
      padding: var(--space-1);
      font-size: 11px;
    }

    .cv-nav {
      display: none;
    }

    .cv-profile {
      margin-bottom: var(--space-2);
      padding-bottom: var(--space-1);
    }

    .cv-section {
      margin-bottom: var(--space-2);
    }

    .section-title {
      font-size: 14px;
      margin-bottom: var(--space-1);
      padding-bottom: var(--space-1);
    }

    .profile-name {
      font-size: 16px;
    }

    .headline-title {
      font-size: 13px;
    }

    .project-link {
      color: var(--color-text-primary) !important;
      text-decoration: none;
    }

    .experience-item,
    .project-item,
    .education-item {
      break-inside: avoid;
      padding: var(--space-1) 0;
      margin-bottom: var(--space-1);
    }

    .skill-list {
      gap: var(--space-1);
    }

    .skill-item {
      padding: 2px var(--space-1);
      font-size: 10px;
    }

    .experience-company-wrapper {
      gap: 8pt;
    }

    .experience-icon {
      width: 32pt;
      height: 32pt;
      background-color: #f5f5f5;
    }
  }
</style>
