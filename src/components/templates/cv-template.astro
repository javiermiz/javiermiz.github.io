---
import Layout from "@components/Layout.astro";
import Image from "astro/components/Image.astro";
import NavButton from "@components/molecules/NavButton.astro";
import SkillItem from "@components/molecules/SkillItem.astro";
import AchievementItem from "@components/molecules/AchievementItem.astro";
import ProjectCard from "@components/molecules/ProjectCard.astro";
import ExperienceCard from "@components/molecules/ExperienceCard.astro";
import {
  MapPin,
  Clock,
  Briefcase,
  BookOpen,
  GraduationCap,
  FolderGit2,
} from "lucide-react";

export interface Props {
  data: any; // CV_DATA from locale
}

const { data } = Astro.props;
const CV_DATA = data;
---

<main>
  {/* Profile Header */}
  <section>
    <div>
      {/* Avatar */}
      <div>
        <Image src="/profile-og.jpg" alt="Javier Miz" width="96" height="96" />
      </div>

      {/* Info */}
      <div>
        <div>
          <span>
            <Clock />
            {CV_DATA.profile.availability}
          </span>
        </div>

        <div>
          <h1>
            {CV_DATA.profile.name}
          </h1>
          <p>
            {CV_DATA.profile.role}
          </p>
        </div>

        <div>
          <span>
            <MapPin />
            {CV_DATA.profile.location}
          </span>
        </div>
      </div>
    </div>

    <div>
      {/* Navigation Buttons */}
      <nav aria-label="Page sections">
        <NavButton
          href="#expertise"
          icon={Briefcase}
          text={CV_DATA.ui.sections.skills}
        />
        <NavButton
          href="#projects"
          icon={FolderGit2}
          text={CV_DATA.ui.sections.projects}
        />
        <NavButton
          href="#experience"
          icon={BookOpen}
          text={CV_DATA.ui.sections.experience}
        />
        <NavButton
          href="#education"
          icon={GraduationCap}
          text={CV_DATA.ui.sections.education}
        />
      </nav>
    </div>

    <div>
      {/* Headline */}
      <div>
        <h2>
          {CV_DATA.profile.headline}
        </h2>
        <p>
          {CV_DATA.profile.subheadline}
        </p>
      </div>

      {/* Key Achievements */}
      <div>
        <h3>
          {CV_DATA.ui.labels.keyAchievements}
        </h3>
        <ul>
          {
            CV_DATA.highlights.map((highlight: string) => (
              <AchievementItem text={highlight} />
            ))
          }
        </ul>
      </div>

      {/* About */}
      <p>
        {CV_DATA.profile.about}
      </p>
    </div>

    {/* Expertise */}
    <div id="expertise">
      <h2>
        <Briefcase />
        {CV_DATA.ui.sections.skills}
      </h2>

      <div>
        {/* Technical Skills */}
        <div>
          <h3>
            {CV_DATA.ui.labels.technicalSkills}
          </h3>
          <div>
            {
              CV_DATA.expertise.technical_skills.map(
                (skill: any, index: number) => (
                  <SkillItem
                    name={skill.name}
                    level={skill.level}
                    isLast={
                      index === CV_DATA.expertise.technical_skills.length - 1
                    }
                  />
                ),
              )
            }
          </div>
        </div>

        {/* Soft Skills */}
        <div>
          <h3>
            {CV_DATA.ui.labels.professionalSkills}
          </h3>
          <div>
            {
              CV_DATA.expertise.soft_skills.map(
                (skill: string, index: number) => (
                  <SkillItem
                    name={skill}
                    isLast={index === CV_DATA.expertise.soft_skills.length - 1}
                  />
                ),
              )
            }
          </div>
        </div>

        {/* Tools & Platforms */}
        <div>
          <h3>
            {CV_DATA.ui.labels.toolsPlatforms}
          </h3>
          <div>
            {
              CV_DATA.expertise.tools_platforms.map(
                (tool: string, index: number) => (
                  <SkillItem
                    name={tool}
                    isLast={
                      index === CV_DATA.expertise.tools_platforms.length - 1
                    }
                  />
                ),
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Projects */}
  <section id="projects">
    <h2>
      {CV_DATA.ui.labels.recentProjects}
    </h2>
    <div>
      {
        CV_DATA.projects.map((project: any) => (
          <ProjectCard
            icon={project.icon}
            name={project.name}
            involvement={project.involvement}
            note={project.note}
            url={project.url}
            buttonText={project.buttonText}
            defaultButtonText={CV_DATA.ui.labels.viewProject}
          />
        ))
      }
    </div>
  </section>

  {/* Experience */}
  <section id="experience">
    <h2>
      {CV_DATA.ui.labels.workExperience}
    </h2>
    <div>
      {
        CV_DATA.experience.map((job: any) => (
          <ExperienceCard
            icon={job.icon}
            company={job.company}
            role={job.role}
            location={job.location}
            period={job.period}
            current={job.current}
            currentLabel={CV_DATA.ui.labels.current}
            impactSummary={job.impact_summary}
            techStack={job.tech_stack}
            keyContributions={job.key_contributions}
          />
        ))
      }
    </div>
  </section>

  {/* Education */}
  <section id="education">
    <h2>
      {CV_DATA.ui.sections.education}
    </h2>
    <div>
      <h3>
        {CV_DATA.education.degree}
      </h3>
      <p>
        {CV_DATA.education.institution}
      </p>
      <p>
        {CV_DATA.education.year}
      </p>
      <p>
        {CV_DATA.education.relevance}
      </p>
    </div>
  </section>

  <style>
    #expertise,
    #experience,
    #projects,
    #education {
      scroll-margin-top: 2rem;
    }
  </style>
</main>
