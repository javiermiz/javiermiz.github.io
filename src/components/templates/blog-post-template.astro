---
// Reusable blog post template
import { type CollectionEntry } from "astro:content";
import Layout from "../Layout.astro";
import { SITE_CONFIG } from "../layout";

// Define props interface
interface Props {
  post: CollectionEntry<"blog">;
  language: "en" | "es";
  back_link_url: string;
  back_link_text: string;
  updated_text: string;
}

// Get props
const { post, language, back_link_url, back_link_text, updated_text } =
  Astro.props;
const { Content } = await post.render();

// Format date helper function
function format_date(date: Date, language: "en" | "es"): string {
  const locale = language === "es" ? "es-ES" : "en-US";
  return new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}

// SEO meta
const page_title = post.data.seo_title || post.data.title;
const page_description = post.data.seo_description || post.data.description;
---

<Layout
  title={`${page_title} | ${SITE_CONFIG.title}`}
  description={page_description}
  lang={language}
>
  <!-- Article Header -->
  <article class="blog-post">
    <header class="post-header">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb">
        <a href={back_link_url}>Blog</a>
        <span class="separator">→</span>
        <span class="current">{post.data.title}</span>
      </nav>

      <!-- Post Meta -->
      <div class="post-meta">
        <time datetime={post.data.published_date.toISOString()}>
          {format_date(post.data.published_date, language)}
        </time>
        <span class="separator">•</span>
        <span class="category">{post.data.category}</span>
      </div>

      <!-- Post Title -->
      <h1 class="post-title">{post.data.title}</h1>

      <!-- Featured Image (conditional) -->
      {
        post.data.featured_image && (
          <div class="featured-image">
            <img
              src={post.data.featured_image}
              alt={post.data.featured_image_alt || post.data.title}
              loading="lazy"
            />
          </div>
        )
      }
    </header>

    <!-- Post Content -->
    <div class="post-content">
      <Content />
    </div>

    <!-- Post Footer -->
    <footer class="post-footer">
      {
        post.data.updated_date && (
          <p class="updated-date">
            {updated_text}: {format_date(post.data.updated_date, language)}
          </p>
        )
      }

      <div class="post-actions">
        <a href={back_link_url} class="back-link">← {back_link_text}</a>
      </div>
    </footer>
  </article>
</Layout>

<style is:global>
  /* Mobile-First Base Layout */
  .blog-post {
    max-width: 100%;
    margin: 0 auto;
    padding: var(--space-3);
  }

  /* Header - Simplified */
  .post-header {
    margin-bottom: var(--space-4);
  }

  /* Navigation & Meta - Streamlined */
  .breadcrumb,
  .post-meta {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Links - Minimal styling */
  .breadcrumb a,
  .post-content a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover,
  .post-content a:hover {
    text-decoration: underline;
  }

  /* Text elements */
  .breadcrumb .separator,
  .post-meta .separator {
    color: var(--color-text-muted);
  }

  .breadcrumb .current {
    color: var(--color-text-primary);
  }

  .post-meta .category {
    text-transform: capitalize;
    color: var(--color-primary);
  }

  /* Typography - Simplified */
  .post-title {
    text-wrap: balance;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    line-height: 1.3;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  /* Featured Image - Mobile first */
  .featured-image {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .featured-image img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md);
    display: block;
  }

  /* Content - Mobile optimized */
  .post-content {
    text-wrap: pretty;
    margin-bottom: var(--space-8);
    line-height: var(--line-height-relaxed);
    font-family: var(--font-serif-body);
    color: var(--color-text-body);
  }

  /* Content Typography - Mobile first */
  .post-content h1,
  .post-content h2,
  .post-content h3,
  .post-content h4,
  .post-content h5,
  .post-content h6 {
    text-wrap: balance;
    font-family: var(--font-serif);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-normal);
  }

  .post-content h1 {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    border-bottom: 2px solid var(--color-border-light);
    padding-bottom: var(--space-2);
  }

  .post-content h2 {
    font-size: var(--text-lg);
    margin-top: var(--space-8);
  }

  .post-content h3 {
    font-size: var(--text-base);
    color: var(--color-primary-hover);
  }

  .post-content h4 {
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }

  .post-content h5,
  .post-content h6 {
    font-size: var(--text-xs);
    margin-top: var(--space-4);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  /* Text elements - Reduced spacing */
  .post-content p {
    margin-bottom: var(--space-4);
    line-height: var(--line-height-relaxed);
  }

  .post-content p:last-child {
    margin-bottom: 0;
  }

  /* Links - Enhanced styling */
  .post-content a {
    text-decoration: underline;
    text-decoration-color: var(--color-primary-light);
    text-underline-offset: 0.2em;
  }

  /* Lists - Mobile first */
  .post-content ul,
  .post-content ol {
    margin: var(--space-3) 0;
    padding-left: var(--space-4);
    line-height: var(--line-height-relaxed);
  }

  .post-content ul {
    list-style-type: disc;
  }
  .post-content ol {
    list-style-type: decimal;
  }
  .post-content ul ul {
    list-style-type: circle;
  }
  .post-content ul ul ul {
    list-style-type: square;
  }

  .post-content li {
    margin-bottom: var(--space-1);
    padding-left: var(--space-1);
  }

  .post-content li:last-child {
    margin-bottom: 0;
  }

  .post-content li > ul,
  .post-content li > ol {
    margin: var(--space-1) 0;
  }

  /* Code - Mobile first */
  .post-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .post-content pre {
    background: var(--color-bg-code);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    padding: var(--space-2);
    margin: var(--space-3) 0;
    overflow-x: auto;
    font-size: var(--text-xs);
    line-height: var(--line-height-relaxed);
    box-shadow: var(--shadow-sm);
  }

  .post-content pre code {
    background: none;
    border: none;
    padding: 0;
  }

  .post-content :not(pre) > code {
    background: var(--color-bg-code);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-sm);
    padding: 0.2em 0.4em;
    color: var(--color-primary);
    font-weight: var(--font-medium);
  }

  /* Blockquotes - Mobile first */
  .post-content blockquote {
    border-left: 4px solid var(--color-primary);
    background: var(--color-bg-subtle);
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: var(--line-height-loose);
    color: var(--color-text-secondary);
    border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0;
    box-shadow: var(--shadow-sm);
  }

  .post-content blockquote p {
    margin-bottom: var(--space-3);
  }

  .post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .post-content blockquote cite {
    display: block;
    margin-top: var(--space-3);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    text-align: right;
  }

  .post-content blockquote cite::before {
    content: "— ";
  }

  /* Media - Mobile first */
  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md);
    margin: var(--space-3) 0;
    display: block;
  }

  .post-content figure {
    margin: var(--space-6) 0;
    text-align: center;
  }

  .post-content figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-style: italic;
    text-align: center;
  }

  /* Tables - Mobile first */
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-3) 0;
    font-size: var(--text-xs);
    box-shadow: var(--shadow-sm);
    border-radius: var(--border-radius-md);
    overflow: hidden;
  }

  .post-content th,
  .post-content td {
    padding: var(--space-2) var(--space-2);
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-content th {
    background: var(--color-bg-subtle);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .post-content tr:hover {
    background: var(--color-bg-hover);
  }
  .post-content tr:last-child td {
    border-bottom: none;
  }

  /* Horizontal Rules - Mobile first */
  .post-content hr {
    border: none;
    height: 1px;
    background: var(--color-border-light);
    margin: var(--space-4) 0;
  }

  /* Text Formatting - Mobile first */
  .post-content strong {
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
  }
  .post-content em {
    font-style: italic;
    color: var(--color-text-secondary);
  }
  .post-content small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .post-content del {
    text-decoration: line-through;
    color: var(--color-text-muted);
  }
  .post-content ins {
    text-decoration: underline;
    color: var(--color-accent);
  }
  .post-content mark {
    background: var(--color-bg-highlight);
    padding: 0.1em 0.2em;
    border-radius: var(--border-radius-sm);
  }

  /* Post Footer - Mobile first */
  .post-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .post-footer .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-full);
    transition: var(--transition-all);
    background: var(--color-bg-primary);
  }

  .post-footer .back-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-bg-subtle);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .post-footer .back-link svg {
    width: 1em;
    height: 1em;
    transition: var(--transition-transform);
  }

  .post-footer .back-link:hover svg {
    transform: translateX(-2px);
  }

  .updated-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-4) 0;
  }

  /* Responsive Design - Mobile first with min-width */
  @media (min-width: 481px) {
    .blog-post {
      padding: var(--space-6);
    }
    .post-header {
      margin-bottom: var(--space-8);
    }
    .post-title {
      font-size: var(--text-3xl);
      margin-bottom: var(--space-3);
    }
    .featured-image {
      margin-top: var(--space-6);
      margin-bottom: var(--space-4);
    }
    .post-description {
      font-size: var(--text-lg);
      margin-bottom: var(--space-6);
    }
    .post-content {
      margin-bottom: var(--space-12);
    }
    .post-content h1 {
      font-size: var(--text-2xl);
      margin-top: var(--space-10);
    }
    .post-content h2 {
      font-size: var(--text-xl);
      margin-top: var(--space-10);
    }
    .post-content h3 {
      font-size: var(--text-lg);
      margin-top: var(--space-8);
    }
    .post-content h4 {
      font-size: var(--text-base);
      margin-top: var(--space-6);
    }
    .post-content h5,
    .post-content h6 {
      font-size: var(--text-sm);
      margin-top: var(--space-6);
    }
    .post-content ul,
    .post-content ol {
      margin: var(--space-4) 0;
      padding-left: var(--space-6);
    }
    .post-content li {
      margin-bottom: var(--space-2);
    }
    .post-content pre {
      padding: var(--space-4);
      margin: var(--space-6) 0;
      font-size: var(--text-sm);
    }
    .post-content blockquote {
      margin: var(--space-6) 0;
      padding: var(--space-4) var(--space-6);
    }
    .post-content img {
      margin: var(--space-6) 0;
    }
    .post-content table {
      margin: var(--space-6) 0;
      font-size: var(--text-sm);
    }
    .post-content th,
    .post-content td {
      padding: var(--space-3) var(--space-4);
    }
    .post-content hr {
      margin: var(--space-8) 0;
    }
    .post-footer {
      margin-top: var(--space-12);
      padding-top: var(--space-6);
      font-size: var(--text-sm);
    }
  }

  @media (min-width: 769px) {
    .blog-post {
      padding: var(--space-8);
    }
    .post-title {
      font-size: var(--text-4xl);
    }
    .featured-image {
      margin-top: var(--space-8);
      margin-bottom: var(--space-6);
    }
    .post-content h1 {
      font-size: var(--text-3xl);
    }
    .post-content h2 {
      font-size: var(--text-2xl);
    }
    .post-content h3 {
      font-size: var(--text-xl);
    }
    .post-content h4 {
      font-size: var(--text-lg);
    }
    .post-content h5,
    .post-content h6 {
      font-size: var(--text-base);
    }
  }

  /* Print Styles - Mobile first optimized */
  @media print {
    .blog-post {
      max-width: none;
      padding: var(--space-3);
      box-shadow: none;
      border: none;
    }

    .breadcrumb,
    .post-footer {
      display: none;
    }

    .post-header {
      border-bottom: 2px solid #000;
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-3);
    }

    .post-title {
      color: #000;
      font-size: 24pt;
    }
    .featured-image {
      margin: var(--space-3) 0;
    }
    .featured-image img {
      max-width: 100%;
      height: auto;
      border: 1px solid #ccc;
      border-radius: 0;
      box-shadow: none;
    }
    .post-meta {
      color: #666;
      font-size: 10pt;
    }
    .post-content {
      color: #000;
      line-height: 1.4;
    }
    .post-content a {
      color: var(--color-text-body);
      text-decoration: underline;
    }
    .post-content a[href]:after {
      content: " (" attr(href) ")";
      font-size: 10pt;
      color: #666;
    }

    .post-content pre {
      border: 1px solid var(--color-border-light);
      background: #f5f5f5;
      padding: var(--space-2);
      font-size: var(--text-xs);
      overflow: visible;
      white-space: pre-wrap;
    }

    .post-content blockquote {
      border-left: 3pt solid #ccc;
      background: none;
      padding: var(--space-2) var(--space-3);
      margin: var(--space-3) 0;
      font-style: italic;
    }

    .post-content img {
      max-width: 100%;
      height: auto;
      border: 1px solid #ccc;
      margin: var(--space-3) 0;
    }
    .post-content table {
      border-collapse: collapse;
      width: 100%;
      font-size: var(--text-xs);
    }
    .post-content th,
    .post-content td {
      border: 1px solid #ccc;
      padding: 3pt 4pt;
      text-align: left;
    }
    .post-content th {
      background: #f0f0f0;
      font-weight: bold;
    }
    .post-content h1,
    .post-content h2,
    .post-content h3 {
      margin-top: var(--space-4);
    }
  }
</style>
