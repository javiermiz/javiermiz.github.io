---
// Reusable blog post template
import { type CollectionEntry } from "astro:content";
import Layout from "../Layout.astro";
import { SITE_CONFIG } from "../layout";

// Define props interface
interface Props {
  post: CollectionEntry<"blog">;
  language: "en" | "es";
  back_link_url: string;
  back_link_text: string;
  updated_text: string;
}

// Get props
const { post, language, back_link_url, back_link_text, updated_text } = Astro.props;
const { Content } = await post.render();

// Format date helper function
function format_date(date: Date, language: "en" | "es"): string {
  const locale = language === "es" ? "es-ES" : "en-US";
  return new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}

// SEO meta
const page_title = post.data.seo_title || post.data.title;
const page_description = post.data.seo_description || post.data.description;
---

<Layout
  title={`${page_title} | ${SITE_CONFIG.title}`}
  description={page_description}
  lang={language}
>
  <!-- Article Header -->
  <article class="blog-post">
    <header class="post-header">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb">
        <a href={back_link_url}>Blog</a>
        <span class="separator">→</span>
        <span class="current">{post.data.title}</span>
      </nav>

      <!-- Post Meta -->
      <div class="post-meta">
        <time datetime={post.data.published_date.toISOString()}>
          {format_date(post.data.published_date, language)}
        </time>
        <span class="separator">•</span>
        <span class="category">{post.data.category}</span>
        <span class="separator">•</span>
      </div>

      <!-- Post Title -->
      <h1 class="post-title">{post.data.title}</h1>

      <!-- Post Description -->
      <p class="post-description">{post.data.description}</p>
    </header>

    <!-- Post Content -->
    <div class="post-content">
      <Content />
    </div>

    <!-- Post Footer -->
    <footer class="post-footer">
      {
        post.data.updated_date && (
          <p class="updated-date">
            {updated_text}: {format_date(post.data.updated_date, language)}
          </p>
        )
      }

      <div class="post-actions">
        <a href={back_link_url} class="back-link">← {back_link_text}</a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  /* Article Layout */
  .blog-post {
    max-width: var(--max-width-reading);
    margin: 0 auto;
  }

  /* Post Header */
  .post-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* Breadcrumb */
  .breadcrumb {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb .separator {
    margin: 0 var(--space-2);
    color: var(--color-text-muted);
  }

  .breadcrumb .current {
    color: var(--color-text-primary);
  }

  /* Post Meta */
  .post-meta {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post-meta .separator {
    color: var(--color-text-muted);
  }

  .post-meta .category {
    text-transform: capitalize;
    color: var(--color-primary);
  }

  /* Post Title */
  .post-title {
    font-size: var(--text-4xl);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  /* Post Description */
  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-6);
  }

  /* Post Content */
  .post-content {
    margin-bottom: var(--content-spacing-lg);
    line-height: var(--line-height-loose);
  }

  /* Typography within content */
  .post-content h1,
  .post-content h2,
  .post-content h3,
  .post-content h4,
  .post-content h5,
  .post-content h6 {
    margin-top: var(--content-spacing-md);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    font-family: var(--font-serif);
  }

  .post-content h2 {
    font-size: var(--text-2xl);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .post-content h3 {
    font-size: var(--text-xl);
  }

  .post-content h4 {
    font-size: var(--text-lg);
  }

  .post-content p {
    margin-bottom: var(--space-6);
    color: var(--color-text-body);
  }

  .post-content ul,
  .post-content ol {
    margin-bottom: var(--space-6);
    padding-left: var(--space-8);
  }

  .post-content li {
    margin-bottom: var(--space-2);
    color: var(--color-text-body);
  }

  .post-content blockquote {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-6);
    margin: var(--content-spacing-md) 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .post-content code {
    background-color: var(--color-bg-code);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .post-content pre {
    background-color: var(--color-bg-code);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--content-spacing-md) 0;
    border: 1px solid var(--color-border-subtle);
  }

  .post-content pre code {
    background: none;
    padding: 0;
  }

  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--content-spacing-md) 0;
  }

  .post-content a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .post-content a:hover {
    text-decoration: underline;
  }

  /* Post Footer */
  .post-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .updated-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-3xl);
    }

    .post-description {
      font-size: var(--text-base);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .post-meta .separator {
      display: none;
    }

    .post-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .breadcrumb {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 480px) {
    .post-title {
      font-size: var(--text-2xl);
    }

    .post-content {
      font-size: var(--text-sm);
    }

    .post-content h2 {
      font-size: var(--text-xl);
    }

    .post-content h3 {
      font-size: var(--text-lg);
    }
  }
</style>