---
// src/layouts/Layout.astro
import Sidebar from './Sidebar.astro';
import { SITE_CONFIG, type SiteLanguage } from './layout'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
  lang?: SiteLanguage
  keywords?: string
  author?: string
  structuredData?: object
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  ogImage = SITE_CONFIG.ogImage,
  noIndex = false,
  lang = SITE_CONFIG.i18n.defaultLang,
  keywords = SITE_CONFIG.metadata.keywords,
  author = SITE_CONFIG.creator,
  structuredData = SITE_CONFIG.metadata.structuredData
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.url)

const toggleLangUrl = lang === 'en' ? '/es' : '/'
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark:bg-zinc-900">
  <head>
    <!-- Character encoding and viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Robots -->
    {noIndex && (
      <meta name="robots" content="noindex, nofollow" />
      <meta name="googlebot" content="noindex, nofollow" />
    )}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="Javier Miz - Frontend Developer" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE_CONFIG.creator} />
    
    <!-- Additional SEO Meta Tags -->
    <meta name="language" content={lang} />
    <meta name="revisit-after" content="7 days" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    
    <!-- Theme -->
    <meta name="theme-color" content={SITE_CONFIG.metadata.themeColor} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="min-h-screen bg-zinc-50 font-article antialiased transition-colors duration-300 text-zinc-900">

    <Sidebar 
      email={SITE_CONFIG.contact.email}
      currentLang={lang}
    />

    <div class="flex-1 pt-16 lg:pt-0 lg:ml-[calc(50%-220px)] transition-all duration-300 bg-amber-50">
        <slot />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'SchibstedGrotesk';
    src: url('/fonts/SchibstedGrotesk.ttf') format('truetype');
    font-weight: 400 800;
    font-style: normal;
    font-display: swap;
    font-feature-settings: "liga" 1, "calt" 1;
  }
  
  @font-face {
    font-family: 'Domine';
    src: url('/fonts/Domine.ttf') format('truetype');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
    font-feature-settings: "liga" 1, "calt" 1;
  }

  :root {
    --font-primary: 'SchibstedGrotesk', system-ui, sans-serif;
    --font-article: 'Domine', serif;
  }

  html {
    font-size: 18px;
  }
</style>