---
// Minimal Layout for Blog Project
import { SITE_CONFIG, type SiteLanguage } from "./layout";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  lang?: SiteLanguage;
  keywords?: string;
  author?: string;
  structuredData?: object;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  ogImage = SITE_CONFIG.ogImage,
  noIndex = false,
  lang = SITE_CONFIG.i18n.defaultLang,
  keywords = SITE_CONFIG.metadata.keywords,
  author = SITE_CONFIG.creator,
  structuredData = SITE_CONFIG.metadata.structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.url);

// Simple language toggle - always use English path structure
function getToggleLangUrl(currentPath: string, currentLang: string): string {
  if (currentLang === "en") {
    // English to Spanish - add /es prefix
    if (currentPath === "/") return "/es";
    return "/es" + currentPath;
  } else {
    // Spanish to English - remove /es prefix
    if (currentPath === "/es" || currentPath === "/es/") return "/";
    return currentPath.replace("/es", "") || "/";
  }
}

const toggleLangUrl = getToggleLangUrl(Astro.url.pathname, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Character encoding and viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.png" />

    <!-- Classic Minimalism Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, SITE_CONFIG.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL(ogImage, SITE_CONFIG.url)}
    />

    <!-- Structured Data -->
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Theme Color -->
    <meta name="theme-color" content="#FFFFFF" />
  </head>

  <body class="font-serif">
    <!-- Minimal Header -->
    <header class="site-header">
      <div class="header-content">
        <a href={lang === "en" ? "/" : "/es"} class="site-logo">Javier Miz</a>
        <nav class="main-nav">
          <a href={lang === "en" ? "/cv" : "/es/cv"}>CV</a>
          <a href={toggleLangUrl} class="lang-toggle"
            >{lang === "en" ? "ES" : "EN"}</a
          >
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Minimal Footer -->
    <footer class="site-footer">
      <div class="footer-content">
        <p>&copy; 2025 Javier Miz Arévalo</p>
        <div class="footer-links">
          <a target="_blank" href="https://github.com/javiermiz">GitHub</a>
          <a target="_blank" href="https://www.linkedin.com/in/javier-miz/"
            >LinkedIn</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Classic Minimalism Design Tokens */
  :root {
    /* Typography - Serif First */
    --font-serif: "Playfair Display", "Georgia", "Times New Roman", serif;
    --font-serif-body: "Georgia", "Times New Roman", serif;
    --font-mono: "Fira Code", "Monaco", monospace;

    /* Primary Colors - Red Accent on White */
    --color-primary: #dc2626;
    --color-primary-hover: #b91c1c;
    --color-primary-light: #f87171;

    /* Neutral Palette - Clean Whites & Grays */
    --color-neutral-50: #fafafa;
    --color-neutral-100: #f5f5f5;
    --color-neutral-200: #e5e5e5;
    --color-neutral-300: #d4d4d4;
    --color-neutral-400: #a3a3a3;
    --color-neutral-500: #737373;
    --color-neutral-600: #525252;
    --color-neutral-700: #404040;
    --color-neutral-800: #262626;
    --color-neutral-900: #171717;

    /* Text Colors - Dark on White with Red Accents */
    --color-text-primary: #171717;
    --color-text-secondary: #404040;
    --color-text-muted: #737373;
    --color-text-light: #a3a3a3;
    --color-text-body: #262626;

    /* Background Colors - Clean White Base */
    --color-bg-primary: #ffffff;
    --color-bg-secondary: #fafafa;
    --color-bg-tertiary: #f5f5f5;
    --color-bg-code: #f8f8f8;

    /* Border Colors - Subtle Grays */
    --color-border-light: #e5e5e5;
    --color-border-medium: #d4d4d4;
    --color-border-subtle: #f5f5f5;
    --color-border-elegant: #c0c0c0;

    /* Typography Scale - Elegant Proportions */
    --text-xs: 0.8rem;
    --text-sm: 0.9rem;
    --text-base: 1.1rem;
    --text-lg: 1.25rem;
    --text-xl: 1.4rem;
    --text-2xl: 1.75rem;
    --text-3xl: 2.25rem;
    --text-4xl: 3rem;

    /* Font Weights - Refined Hierarchy */
    --font-light: 300;
    --font-normal: 400;
    --font-medium: 500;
    --font-semibold: 600;
    --font-bold: 700;

    /* Line Heights - Generous & Classical */
    --line-height-tight: 1.25;
    --line-height-snug: 1.375;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.65;
    --line-height-loose: 1.8;

    /* Letter Spacing - Subtle Refinement */
    --letter-spacing-tight: -0.025em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.025em;
    --letter-spacing-wider: 0.05em;

    /* Spacing Scale - Generous & Measured */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-24: 6rem;

    /* Content Spacing - Classical Proportions */
    --content-spacing-xs: var(--space-4);
    --content-spacing-sm: var(--space-6);
    --content-spacing-md: var(--space-8);
    --content-spacing-lg: var(--space-12);
    --content-spacing-xl: var(--space-16);

    /* Shadows - Soft & Natural */
    --shadow-subtle: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    --shadow-soft: 0 4px 6px -1px rgba(0, 0, 0, 0.07);
    --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    --shadow-large: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
    --shadow-elegant: 0 8px 30px rgba(0, 0, 0, 0.06);

    /* Transitions - Elegant & Smooth */
    --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-elegant: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    /* Border Radius - Subtle Refinement */
    --radius-none: 0;
    --radius-sm: 0.125rem;
    --radius-md: 0.25rem;
    --radius-lg: 0.375rem;
    --radius-xl: 0.5rem;
    --radius-elegant: 0.375rem;

    /* Layout - Classical Proportions */
    --max-width-content: 800px;
    --max-width-wide: 1200px;
    --max-width-reading: 65ch;
  }

  /* Global Classic Minimalism Styles */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-serif-body);
    font-size: var(--text-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-body);
    background-color: var(--color-bg-primary);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Elegant serif headings with generous spacing */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    font-weight: var(--font-semibold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--content-spacing-sm);
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Header Styles - Classic Minimalism */
  .site-header {
    padding: var(--content-spacing-xs) 0;
    background-color: var(--color-bg-primary);
    box-shadow: var(--shadow-subtle);
  }

  .header-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--content-spacing-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-tight);
    transition: color var(--transition-elegant);
  }

  .site-logo:hover {
    color: var(--color-primary);
  }

  .main-nav {
    display: flex;
    gap: var(--content-spacing-md);
    align-items: center;
  }

  .main-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-normal);
    letter-spacing: var(--letter-spacing-normal);
    transition: color var(--transition-elegant);
    padding: var(--space-1) 0;
    position: relative;
  }

  .main-nav a:hover {
    color: var(--color-primary);
  }
  .main-nav a:hover::after {
    width: 100%;
  }

  .lang-toggle {
    font-family: var(--font-serif-body) !important;
    color: var(--color-text-muted) !important;
    font-size: var(--text-xs) !important;
    font-weight: var(--font-semibold) !important;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    padding: var(--space-1) var(--space-2) !important;
    border: 1px solid var(--color-border-subtle) !important;
    background-color: var(--color-bg-primary) !important;
    min-width: 2.5rem;
    text-align: center;
  }

  .lang-toggle:hover {
    color: var(--color-primary) !important;
    background-color: var(--color-bg-tertiary) !important;
  }

  .lang-toggle::after {
    display: none !important;
  }

  /* Main Content - Classic Minimalism */
  .main-content {
    flex: 1;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--content-spacing-xl) var(--content-spacing-sm);
    width: 100%;
    min-height: 60vh;
  }

  /* Footer Styles - Classic Minimalism */
  .site-footer {
    border-top: 1px solid var(--color-border-elegant);
    padding: var(--content-spacing-lg) 0;
    margin-top: auto;
    background-color: var(--color-bg-secondary);
  }

  .footer-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--content-spacing-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--content-spacing-sm);
  }

  .footer-content p {
    font-family: var(--font-serif-body);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: var(--letter-spacing-wide);
  }

  .footer-links {
    display: flex;
    gap: var(--content-spacing-md);
  }

  .footer-links a {
    font-family: var(--font-serif-body);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--letter-spacing-wide);
    transition: all var(--transition-elegant);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-elegant);
  }

  .footer-links a:hover {
    color: var(--color-primary);
    background-color: var(--color-bg-tertiary);
    box-shadow: var(--shadow-subtle);
    text-decoration: none;
  }

  /* Responsive Design - Classic Minimalism */
  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      gap: var(--content-spacing-sm);
      padding: 0 var(--space-4);
    }

    .main-nav {
      gap: var(--content-spacing-sm);
    }

    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: var(--content-spacing-xs);
    }

    .main-content {
      padding: var(--content-spacing-md) var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding: var(--content-spacing-sm) 0;
    }

    .main-content {
      padding: var(--content-spacing-sm) var(--space-3);
    }

    .main-nav a {
      padding: var(--space-1) var(--space-2);
      font-size: 0.8rem;
    }
  }
</style>
