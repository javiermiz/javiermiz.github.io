---
// src/components/layout/Sidebar.astro
import {
  Languages,
  Mail,
  Github,
  Linkedin,
  Home,
  Menu,
  X,
  Book,
} from "lucide-react";
import { type SiteLanguage, SITE_CONFIG } from "./layout";
import { Image } from "astro:assets";

interface Props {
  email: string;
  currentLang: SiteLanguage;
}

const { email, currentLang } = Astro.props;

// Sidebar configuration based on current language
const sidebar_config = {
  en: {
    navigation_items: [
      {
        type: "link",
        href: "/",
        icon: Book,
        classes: "text-red-400 hover:bg-red-500 hover:text-violet-800",
        label: "Blog",
        aria_label: "Blog",
      },
      {
        type: "link",
        href: "/cv",
        icon: Github,
        classes: "text-teal-300 hover:bg-teal-300 hover:text-violet-800",
        label: "CV",
        aria_label: "CV",
      },
    ],
    social_links: [
      {
        type: "social",
        href: SITE_CONFIG.social.linkedin,
        icon: Linkedin,
        label: "LinkedIn ",
        aria_label: "LinkedIn Profile",
        external: true,
      },
      {
        type: "link",
        href: "/contact",
        icon: Mail,
        classes: "text-pink-400 hover:bg-pink-300 hover:text-violet-800",
        label: "Contact",
        aria_label: "Contact",
      },
    ],
    action_items: [
      {
        type: "button",
        id: "toggle-language",
        icon: Languages,
        label: "ES",
        aria_label: "Change language to ES",
      },
    ],
  },
  es: {
    navigation_items: [
      {
        type: "link",
        href: "/es/",
        icon: Book,
        classes: "text-teal-400 hover:bg-teal-400 hover:text-violet-800",
        label: "Blog",
        aria_label: "Blog",
      },
      {
        type: "link",
        href: "/es/cv",
        icon: Github,
        classes: "text-pink-400 hover:bg-pink-300 hover:text-violet-800",
        label: "CV",
        aria_label: "CV",
      },
    ],
    social_links: [
      {
        type: "social",
        href: SITE_CONFIG.social.linkedin,
        icon: Linkedin,
        label: "LinkedIn",
        aria_label: "Perfil de LinkedIn",
        external: true,
      },
      {
        type: "link",
        href: "/es/contacto",
        icon: Mail,
        classes: "text-pink-400 hover:bg-pink-300 hover:text-violet-800",
        label: "Contacto",
        aria_label: "Contacto",
      },
    ],
    action_items: [
      {
        type: "button",
        id: "toggle-language",
        icon: Languages,
        label: "EN",
        aria_label: "Change language to EN",
      },
    ],
  },
}[currentLang];
---

<aside id="sidebar">
  <div>
    <div>
      <Image
        src="/profile-og.jpg"
        alt="Javier Miz"
        width="96"
        height="96"
      />
      <h2>Javier Miz</h2>
    </div>

    <nav aria-label="Main navigation">
      {
        sidebar_config.navigation_items.map((item) => (
          <a
            href={item.href}
            aria-label={item.aria_label}
          >
            {item.icon && <item.icon />}
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div>
      {
        sidebar_config.action_items.map((item) => {
          return (
            <button
              id={item.id}
              aria-label={item.aria_label}
            >
              {item.icon && <item.icon />}
              <span>{item.label}</span>
            </button>
          );
        })
      }
    </div>

    <div>
      {
        sidebar_config.social_links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.aria_label}
          >
            <link.icon />
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</aside>

<div id="sidebar-overlay"></div>
<div id="longpress-area"></div>
