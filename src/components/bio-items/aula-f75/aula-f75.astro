---
import { Image } from "astro:assets";
import aulaF75 from "./F75.avif";
---

<a
  class="bio-product-link"
  href="https://s.click.aliexpress.com/e/_c4mdq9mV"
  target="_blank"
  rel="noreferrer"
  data-search="aula f75 teclado mecanico keyboard inalámbrico wireless rgb gasket"
  data-goatcounter-click="bio-aula-f75-aliexpress"
  data-goatcounter-title="AULA F75 - AliExpress"
>
  <div class="simple-card">
    <Image src={aulaF75} alt="AULA F75" width={100} height={100} />
    <div class="content">
      <h2>AULA F75</h2>
      <p>Teclado Mecánico 75% Inalámbrico</p>
    </div>
  </div>
</a>

<style>
  .bio-product-link {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .bio-product-link:active {
    transform: translateY(1px);
  }

  .bio-product-link:hover :global(.simple-card) {
    border-color: var(--color-primary);
  }
</style>
